---

<section class="relative overflow-hidden">
  <div class="container-page pt-10 pb-14 md:pt-16 md:pb-24">
    <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div>
        <div class="chip chip-mint mb-5">
          <div class="status-dot"></div>
          Open to Remote Worldwide
        </div>
        <h1 class="text-[clamp(2.6rem,8vw,4.8rem)] font-extrabold leading-[0.95] tracking-[-0.04em]">
          MAS
          <span class="block">MUHAMMAD<span class="text-accent-deep">.</span></span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-soft md:text-lg">
          <strong class="font-bold text-ink">Senior Backend Engineer</strong> building
          <strong class="font-bold text-ink">.NET, distributed systems &amp; containerized architectures</strong>
          for Fortune 500 clients —
          <span class="font-semibold text-accent-deep">Biogen, Sanofi, Shell, Boston Scientific &amp; Sampoerna</span>.
          13 years of experience, published author, remote-work veteran.
        </p>
        <div class="hero-badges mt-6">
          <span class="badge">.NET Core</span>
          <span class="badge">C# / Go</span>
          <span class="badge">Microservices</span>
          <span class="badge">Docker</span>
          <span class="badge green">100% Delivery Rate</span>
          <span class="badge green">8+ Yrs Remote</span>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#contact" class="btn-brutal btn-accent">
            Get In Touch
            <i class="bi bi-arrow-up-right"></i>
          </a>
          <a href="/portfolio" class="btn-brutal btn-light">View Portfolio</a>
          <a href="/resume" class="btn-brutal btn-light">Download CV</a>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <div class="card-brutal px-4 py-4 text-center">
            <div class="stat-num text-2xl font-extrabold text-accent-deep md:text-3xl" data-count="13">0</div>
            <div class="mt-1 text-[0.7rem] font-semibold uppercase tracking-wide text-ink-mute">Years Exp.</div>
          </div>
          <div class="card-brutal px-4 py-4 text-center">
            <div class="stat-num text-2xl font-extrabold text-accent-deep md:text-3xl" data-count="128">0</div>
            <div class="mt-1 text-[0.7rem] font-semibold uppercase tracking-wide text-ink-mute">DB Shards</div>
          </div>
          <div class="card-brutal px-4 py-4 text-center">
            <div class="stat-num text-2xl font-extrabold text-accent-deep md:text-3xl" data-count="25" data-suffix="K+">0</div>
            <div class="mt-1 text-[0.7rem] font-semibold uppercase tracking-wide text-ink-mute">Archives / Mo</div>
          </div>
          <div class="card-brutal px-4 py-4 text-center">
            <div class="stat-num text-2xl font-extrabold text-accent-deep md:text-3xl" data-count="67">0</div>
            <div class="mt-1 text-[0.7rem] font-semibold uppercase tracking-wide text-ink-mute">Background Jobs</div>
          </div>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="card-brutal relative bg-paper p-5 shadow-brutal-lg md:p-6">
          <div class="flex items-center gap-2 border-b-2 border-ink/10 pb-3">
            <span class="h-3 w-3 rounded-full border-2 border-ink bg-amber"></span>
            <span class="h-3 w-3 rounded-full border-2 border-ink bg-mint"></span>
            <span class="h-3 w-3 rounded-full border-2 border-ink bg-accent"></span>
            <span class="ml-2 font-mono text-xs text-ink-mute">masmuh@web.id</span>
          </div>
          <div class="mt-4 space-y-2 font-mono text-[0.8rem] leading-relaxed md:text-sm">
            <p class="text-ink-soft">$ whoami</p>
            <p class="font-semibold text-accent-deep">senior-backend-engineer / system-architect</p>
            <p class="text-ink-soft">$ cat current-focus.txt</p>
            <p class="text-ink-soft">AI-integrated tooling · on-device inference pipelines</p>
            <p class="text-ink-soft">$ ./ship --delivery-rate</p>
            <p class="font-semibold text-ink">100% <span class="text-ink-mute">// on-time, 0 critical downtime</span></p>
            <p class="text-ink-soft">$ uptime</p>
            <p class="text-ink-soft">8+ years remote · <span class="font-semibold text-ink">ID-Surabaya</span></p>
          </div>
        </div>
        <div class="chip absolute -right-3 -top-4 rotate-3 bg-accent text-white shadow-brutal-sm md:-right-6">
          <i class="bi bi-lightning-charge-fill"></i>
          13+ yrs
        </div>
        <div class="chip absolute -bottom-4 -left-3 -rotate-3 bg-paper shadow-brutal-sm md:-left-6">
          <i class="bi bi-book-fill text-accent-deep"></i>
          Author · .NET 10
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const counters = document.querySelectorAll(".stat-num[data-count]");
  if (counters.length) {
    const animate = (el) => {
      const target = parseInt(el.dataset.count, 10);
      const suffix = el.dataset.suffix || "";
      let current = 0;
      const step = Math.max(1, Math.round(target / 50));
      const timer = setInterval(() => {
        current += step;
        if (current >= target) {
          current = target;
          clearInterval(timer);
        }
        el.textContent = current + suffix;
      }, 20);
    };
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.5 },
    );
    counters.forEach((el) => observer.observe(el));
  }
</script>