---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Page Not Found" description="The page you're looking for doesn't exist.">
  <main class="flex min-h-screen items-center justify-center px-6 py-16">
    <div class="w-full max-w-xl text-center">
      <div class="font-mono text-xs font-bold uppercase tracking-[0.25em] text-accent-deep">
        // System Error
      </div>
      <h1 class="mt-3 text-[clamp(5rem,20vw,11rem)] font-extrabold leading-none tracking-tight">
        404<span class="text-accent-deep">.</span>
      </h1>
      <div class="mt-2 text-xl font-extrabold tracking-tight md:text-2xl">Page Not Found</div>
      <p class="mx-auto mt-4 max-w-md text-[0.95rem] leading-relaxed text-ink-soft">
        The resource you requested does not exist or has been relocated.
        Check the URL or navigate back to a known endpoint.
      </p>

      <div class="card-brutal mt-8 bg-paper p-5 text-left font-mono text-[0.8rem] leading-loose shadow-brutal">
        <div class="flex items-center gap-2 border-b-2 border-ink/10 pb-2.5">
          <span class="h-3 w-3 rounded-full border-2 border-ink bg-red-400"></span>
          <span class="h-3 w-3 rounded-full border-2 border-ink bg-amber-400"></span>
          <span class="h-3 w-3 rounded-full border-2 border-ink bg-mint"></span>
          <span class="ml-2 text-xs text-ink-mute">masmuh@web.id</span>
        </div>
        <div class="mt-3 space-y-1">
          <p><span class="font-bold text-mint">$</span> <span class="text-accent-deep">curl</span> <span class="text-ink">{Astro.url.pathname}</span></p>
          <p class="text-ink-mute italic">// ERROR: 404 — resource not found</p>
          <p><span class="font-bold text-mint">$</span> <span class="cs-cursor"></span></p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-brutal btn-accent">
          <i class="bi bi-arrow-left"></i>
          Back to Home
        </a>
        <a href="/portfolio" class="btn-brutal btn-light">View Portfolio</a>
        <a href="/resume" class="btn-brutal btn-light">View Resume</a>
      </div>
    </div>
  </main>
</Layout>