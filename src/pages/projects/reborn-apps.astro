---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="MS Glow Reborn Ecosystem - Mas Muhammad" description="A comprehensive e-commerce ecosystem for MS Glow cosmetics brand powering product catalog management, seller and store management, order processing with shopping cart lifecycle, genuine product verification via QR, clinic directory, and full content management system. Built with C# (.NET 5) microservices with Vue.js frontends following clean layered architecture with ArgoCD GitOps deployment.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
    <div class="cs-hero-meta">
      <span class="cs-badge badge-consulting">Consulting</span>
      <span class="cs-badge cs-badge-domain">E-commerce</span>
      <span class="cs-badge cs-badge-year">January 2022</span>
    </div>
    <h1 class="cs-hero-title">
      MS Glow<br>
      <span>Reborn Ecosystem</span><span class="cs-cursor"></span>
    </h1>
    <p class="cs-hero-desc">
      A comprehensive e-commerce ecosystem for MS Glow cosmetics brand powering product
      catalog management, seller and store management, order processing with shopping
      cart lifecycle, genuine product verification via QR, clinic directory, and full
      content management system. Built with C# (.NET 5) microservices with Vue.js
      frontends following clean layered architecture with ArgoCD GitOps deployment.
    </p>
    <div class="cs-stack-pills">
      <span class="cs-stack-pill">C# .NET 5</span>
      <span class="cs-stack-pill">Vue.js / Nuxt.js</span>
      <span class="cs-stack-pill">MongoDB</span>
      <span class="cs-stack-pill">JWT Auth</span>
      <span class="cs-stack-pill">AutoMapper</span>
      <span class="cs-stack-pill">Swagger</span>
      <span class="cs-stack-pill">Docker + K8s</span>
      <span class="cs-stack-pill">ArgoCD</span>
    </div>
  </header>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">01</span>
      <span class="cs-section-label-text">Impact &amp; Metrics</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-metrics-grid">
      <div class="cs-metric-card">
        <div class="cs-metric-val">86K+</div>
        <div class="cs-metric-label">Lines of Code</div>
        <div class="cs-metric-sub">C# + JS + CSHTML</div>
      </div>
      <div class="cs-metric-card">
        <div class="cs-metric-val">156+</div>
        <div class="cs-metric-label">API Endpoints</div>
        <div class="cs-metric-sub">RESTful microservices</div>
      </div>
      <div class="cs-metric-card">
        <div class="cs-metric-val">39</div>
        <div class="cs-metric-label">Database Collections</div>
        <div class="cs-metric-sub">MongoDB</div>
      </div>
      <div class="cs-metric-card cs-red">
        <div class="cs-metric-val">10</div>
        <div class="cs-metric-label">Complexity Score</div>
        <div class="cs-metric-sub">Mission Critical</div>
      </div>
    </div>

    <div class="cs-business-line-cards">
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">E-commerce Core</div>
        <div class="cs-bl-card-desc">Product catalog with taxonomy (classification, brand, category, skin concern), shopping cart lifecycle, seller registration and store management, pricing and invoicing.</div>
        <span class="cs-bl-card-tag">Product + Order</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Content Management</div>
        <div class="cs-bl-card-desc">Full CMS for news, journal, banner, brand story, public relations, FAQs, static pages, legal, sub-brands, and YouTube content with image uploads.</div>
        <span class="cs-bl-card-tag cs-amber-tag">Enterprise CMS</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Genuine Verification</div>
        <div class="cs-bl-card-desc">QR-based product authentication system with passphrase generation, hash collection, batch upload, CDN storage, and verify checker API for consumers.</div>
        <span class="cs-bl-card-tag">Anti-Counterfeit</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Directory &amp; Community</div>
        <div class="cs-bl-card-desc">Clinic directory with city-based search, member management, join seller flow, area/geography database (provinces, regencies, districts, villages), and YouTube integration.</div>
        <span class="cs-bl-card-tag cs-amber-tag">Directory</span>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">02</span>
      <span class="cs-section-label-text">Architecture</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-arch-diagram">
      <div class="cs-arch-diagram-inner" style="display:flex; align-items:center; gap:16px; justify-content:center; flex-wrap:wrap;">
        <div class="cs-arch-node cs-source">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Public Storefront</div>
          <div class="cs-arch-node-sub">Nuxt.js SPA</div>
        </div>
        <div class="cs-arch-node cs-source">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Admin Panel</div>
          <div class="cs-arch-node-sub">ASP.NET MVC + JS</div>
        </div>
        <div class="cs-arch-node cs-source">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Genuine Checker</div>
          <div class="cs-arch-node-sub">Vue.js SPA</div>
        </div>
        <div class="cs-arch-arrow" style="min-width: 40px;">
          <div class="cs-arch-arrow-line" style="width: 20px;"></div>
        </div>
        <div style="display:flex; flex-direction:column; align-items:center; gap:0;">
          <div class="cs-arch-node core" style="width:200px;">
            <div class="cs-arch-node-label" style="font-size:13px; margin-bottom:10px;">API Microservices</div>
            <div class="cs-core-stack">
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Main Service (30+ Controllers)</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Products Service</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Genuine Service</div>
              <div class="cs-core-step"><div class="cs-core-step-dot" style="background:var(--blue)"></div>CDN Service</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Background Workers</div>
            </div>
          </div>
        </div>
        <div class="cs-arch-arrow">
          <div class="cs-arch-arrow-line"></div>
          <div class="cs-arch-arrow-label">persist</div>
        </div>
        <div class="cs-arch-node cs-output">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">MongoDB</div>
          <div class="cs-arch-node-sub">33 collections</div>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">03</span>
      <span class="cs-section-label-text">Tech Stack</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr><td class="cs-layer">Runtime</td><td class="cs-tech">.NET 5.0 / .NET Core 3.1 / .NET 6.0</td></tr>
          <tr><td class="cs-layer">Web Framework</td><td class="cs-tech">ASP.NET Core Web API + MVC</td></tr>
          <tr><td class="cs-layer">Frontend</td><td class="cs-tech">Vue.js 2 / Nuxt.js / Razor MVC / jQuery</td></tr>
          <tr><td class="cs-layer">Database</td><td class="cs-tech">MongoDB (33 collections)</td></tr>
          <tr><td class="cs-layer">Auth</td><td class="cs-tech">JWT Bearer + Basic Authentication</td></tr>
          <tr><td class="cs-layer">API Documentation</td><td class="cs-tech">Swagger / Swashbuckle</td></tr>
          <tr><td class="cs-layer">OR/M</td><td class="cs-tech">Custom MongoDBContext + MongoQueryBuilder</td></tr>
          <tr><td class="cs-layer">Export</td><td class="cs-tech">EPPlus, CsvHelper, ExcelDataReader</td></tr>
          <tr><td class="cs-layer">Email</td><td class="cs-tech">MailKit + MimeKit</td></tr>
          <tr><td class="cs-layer">Mapping</td><td class="cs-tech">AutoMapper</td></tr>
          <tr><td class="cs-layer">Background Jobs</td><td class="cs-tech">.NET Worker Service (4 workers)</td></tr>
          <tr><td class="cs-layer">Infrastructure</td><td class="cs-tech">Docker + Kubernetes (GKE) + ArgoCD</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">04</span>
      <span class="cs-section-label-text">Capabilities</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr><td class="cs-layer">Product Catalog</td><td class="cs-tech">SKU management, sub-product taxonomy, category, brand, classification, skin concern, gallery, variants, ingredients</td></tr>
          <tr><td class="cs-layer">Shopping Cart</td><td class="cs-tech">Checkout flow, order management, buyer/seller order views, status tracking</td></tr>
          <tr><td class="cs-layer">Seller Management</td><td class="cs-tech">Registration, activation, city-based lookup, store management, user roles (Admin, Seller, Buyer)</td></tr>
          <tr><td class="cs-layer">Content CMS</td><td class="cs-tech">News, journal, banner (web+mobile), brand story, public relations, FAQs, static pages, terms, legal, sub-brands, YouTube</td></tr>
          <tr><td class="cs-layer">Genuine Verification</td><td class="cs-tech">QR code authentication, passphrase system, hash collection, upload undian, batch processing, CDN delivery</td></tr>
          <tr><td class="cs-layer">Clinic Directory</td><td class="cs-tech">Aesthetic clinic listings, city-based search, contact management</td></tr>
          <tr><td class="cs-layer">Area Database</td><td class="cs-tech">Provinces, regencies, districts, villages — populated and searchable</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  </div>

  <Footer />
</Layout>
