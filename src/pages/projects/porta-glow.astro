---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Porta-Glow - Mas Muhammad" description="A unified customer engagement portal for MS Glow customers featuring Google OAuth single sign-on, customer profile management, application key management, and a backpanel admin interface. Built with C# (.NET 6) following clean architecture patterns with MongoDB persistence and rate-limited APIs.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
    <div class="cs-hero-meta">
      <span class="cs-badge badge-consulting">Consulting</span>
      <span class="cs-badge cs-badge-domain">Customer Portal</span>
      <span class="cs-badge cs-badge-year">December 2022</span>
    </div>
    <h1 class="cs-hero-title">
      Porta-Glow<br>
      <span>Customer Portal</span><span class="cs-cursor"></span>
    </h1>
    <p class="cs-hero-desc">
      A unified customer engagement portal for MS Glow customers featuring Google OAuth
      single sign-on, customer profile management, application key management, and a
      backpanel admin interface. Built with C# (.NET 6) following clean architecture
      patterns with MongoDB persistence and rate-limited APIs.
    </p>
    <div class="cs-stack-pills">
      <span class="cs-stack-pill">C# .NET 6</span>
      <span class="cs-stack-pill">MongoDB</span>
      <span class="cs-stack-pill">Google OAuth</span>
      <span class="cs-stack-pill">AutoMapper</span>
      <span class="cs-stack-pill">FluentValidation</span>
      <span class="cs-stack-pill">Swagger</span>
      <span class="cs-stack-pill">Rate Limiting</span>
    </div>
  </header>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">01</span>
      <span class="cs-section-label-text">Impact &amp; Metrics</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-metrics-grid">
      <div class="cs-metric-card">
        <div class="cs-metric-val">2.5K+</div>
        <div class="cs-metric-label">Lines of Code</div>
        <div class="cs-metric-sub">C# + Razor + CSS</div>
      </div>
      <div class="cs-metric-card">
        <div class="cs-metric-val">4</div>
        <div class="cs-metric-label">API Endpoints</div>
        <div class="cs-metric-sub">RESTful + OAuth</div>
      </div>
      <div class="cs-metric-card">
        <div class="cs-metric-val">7</div>
        <div class="cs-metric-label">Database Models</div>
        <div class="cs-metric-sub">MongoDB collections</div>
      </div>
      <div class="cs-metric-card cs-amber">
        <div class="cs-metric-val">7</div>
        <div class="cs-metric-label">Complexity Score</div>
        <div class="cs-metric-sub">Enterprise System</div>
      </div>
    </div>

    <div class="cs-business-line-cards">
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Authentication</div>
        <div class="cs-bl-card-desc">Google OAuth single sign-on with ASP.NET Core Identity stored in MongoDB, supporting external login and callback flows with JWT-based session management.</div>
        <span class="cs-bl-card-tag">Google OAuth</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Customer Management</div>
        <div class="cs-bl-card-desc">Customer profile CRUD with address management, gender and discount enumeration, and audit trail tracking via ChangesModel for created/updated timestamps.</div>
        <span class="cs-bl-card-tag cs-amber-tag">Profile CRUD</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">API Key Management</div>
        <div class="cs-bl-card-desc">Application ID and key management service with unique key generation, expiration tracking, validator integration, and FluentValidation rules.</div>
        <span class="cs-bl-card-tag">Key Management</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Admin Backpanel</div>
        <div class="cs-bl-card-desc">Separate Swagger-documented API areas for backpanel (v1) and website (v2) with rate limiting (2 requests per 10s) and CORS configuration.</div>
        <span class="cs-bl-card-tag cs-amber-tag">Swagger v1/v2</span>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">02</span>
      <span class="cs-section-label-text">Architecture</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-arch-diagram">
      <div class="cs-arch-diagram-inner">
        <div class="cs-arch-node cs-source">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Auth UI</div>
          <div class="cs-arch-node-sub">ASP.NET MVC</div>
        </div>
        <div class="cs-arch-arrow">
          <div class="cs-arch-arrow-line"></div>
          <div class="cs-arch-arrow-label">HTTPS</div>
        </div>
        <div style="display:flex; flex-direction:column; align-items:center; gap:0;">
          <div class="cs-arch-node core" style="width:200px;">
            <div class="cs-arch-node-label" style="font-size:13px; margin-bottom:10px;">Web API</div>
            <div class="cs-core-stack">
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Backpanel Controllers</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Website Controllers</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Application Services</div>
              <div class="cs-core-step"><div class="cs-core-step-dot" style="background:var(--blue)"></div>Google OAuth</div>
            </div>
          </div>
        </div>
        <div class="cs-arch-arrow">
          <div class="cs-arch-arrow-line"></div>
          <div class="cs-arch-arrow-label">persist</div>
        </div>
        <div class="cs-arch-node cs-output">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">MongoDB</div>
          <div class="cs-arch-node-sub">Identity + Data</div>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">03</span>
      <span class="cs-section-label-text">Tech Stack</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr><td class="cs-layer">Runtime</td><td class="cs-tech">.NET 6.0</td></tr>
          <tr><td class="cs-layer">Web Framework</td><td class="cs-tech">ASP.NET Core Web API + MVC</td></tr>
          <tr><td class="cs-layer">Database</td><td class="cs-tech">MongoDB (MongoDB.Driver 2.14.1)</td></tr>
          <tr><td class="cs-layer">Identity</td><td class="cs-tech">AspNetCore.Identity.MongoDbCore</td></tr>
          <tr><td class="cs-layer">Auth</td><td class="cs-tech">Google OAuth 2.0 + Cookie Authentication</td></tr>
          <tr><td class="cs-layer">API Documentation</td><td class="cs-tech">Swagger / Swashbuckle (v1 Backpanel, v2 Website)</td></tr>
          <tr><td class="cs-layer">Validation</td><td class="cs-tech">FluentValidation 11.4.0</td></tr>
          <tr><td class="cs-layer">Mapping</td><td class="cs-tech">AutoMapper 12.0.0</td></tr>
          <tr><td class="cs-layer">Rate Limiting</td><td class="cs-tech">AspNetCoreRateLimit (2 req / 10s)</td></tr>
          <tr><td class="cs-layer">ORM</td><td class="cs-tech">Custom MongoDBContext + Expression-to-SQL parser</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">04</span>
      <span class="cs-section-label-text">Capabilities</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr><td class="cs-layer">Authentication</td><td class="cs-tech">Google OAuth external login, cookie-based session, callback handling, role-based authorization</td></tr>
          <tr><td class="cs-layer">Customer Management</td><td class="cs-tech">Profile CRUD with address management, gender/discount enums, activation status, audit trail</td></tr>
          <tr><td class="cs-layer">Application Keys</td><td class="cs-tech">API key generation, value management, description, expiration tracking, FluentValidation</td></tr>
          <tr><td class="cs-layer">Application Settings</td><td class="cs-tech">Key-value setting store, configuration management</td></tr>
          <tr><td class="cs-layer">API Areas</td><td class="cs-tech">Separated Backpanel (admin) and Website (public) API groups with distinct Swagger docs</td></tr>
          <tr><td class="cs-layer">Rate Limiting</td><td class="cs-tech">2 requests per 10 seconds per endpoint with configurable policies</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  </div>

  <Footer />
</Layout>
