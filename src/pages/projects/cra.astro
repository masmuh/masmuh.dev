      <span class="cs-stack-pill">C# .NET 4.5/4.8</span>
      <span class="cs-stack-pill">ASP.NET MVC 5</span>
      <span class="cs-stack-pill">Entity Framework 6.4</span>
      <span class="cs-stack-pill">SQL Server</span>
      <span class="cs-stack-pill">JavaScript</span>
      <span class="cs-stack-pill">jQuery DataTables</span>
      <span class="cs-stack-pill">Kendo UI</span>
      <span class="cs-stack-pill">Knockout.js</span>
      <span class="cs-stack-pill">Quartz.NET</span>
      <span class="cs-stack-pill">SSIS</span>
      <span class="cs-stack-pill">SimpleInjector</span>
      <span class="cs-stack-pill">EPPlus</span>
      <span class="cs-stack-pill">NLog</span>
