---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="KaniTax Automation - Mas Muhammad" description="A tax invoice management system built with C# (.NET 6.0). Synchronizes invoices with SAP Business ByDesign, manages customer/supplier master data, handles tax numbering, and provides both REST API and admin backpanel interfaces with JWT authentication and role-based access control.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
<div class="cs-hero-meta">
<span class="cs-badge cs-badge-corporate">Corporate</span><span class="cs-badge cs-badge-client">Tri Hasta Perkasa</span> 
<span class="cs-badge cs-badge-year">December 2022</span>
</div>
<h1 class="cs-hero-title">KaniTax <span>Automation</span><span class="cs-cursor"></span></h1>
<p class="cs-hero-desc">
A tax invoice management system built with C# (.NET 6.0). Synchronizes invoices with SAP Business ByDesign, manages customer/supplier master data, handles tax numbering, and provides both REST API and admin backpanel interfaces with JWT authentication and role-based access control.
</p>
<div class="cs-stack-pills">
<span class="cs-stack-pill">C# .NET 6.0</span>
<span class="cs-stack-pill">ASP.NET Core</span>
<span class="cs-stack-pill">MongoDB</span>
<span class="cs-stack-pill">SAP BYD</span>
<span class="cs-stack-pill">JWT Bearer</span>
<span class="cs-stack-pill">AutoMapper</span>
<span class="cs-stack-pill">Swagger</span>
</div>
</header>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Impact</span>
<div class="cs-section-label-line"></div>
<span class="cs-section-label-num">01</span>
</div>
<div class="cs-metrics-grid">
<div class="cs-metric-card">
<div class="cs-metric-val">7,500+</div>
<div class="cs-metric-label">Lines of Code</div>
<div class="cs-metric-sub">C# across 4 projects</div>
</div>
<div class="cs-metric-card">
<div class="cs-metric-val">21</div>
<div class="cs-metric-label">API Endpoints</div>
<div class="cs-metric-sub">REST + MVC routes</div>
</div>
<div class="cs-metric-card">
<div class="cs-metric-val">10</div>
<div class="cs-metric-label">Complexity Score</div>
<div class="cs-metric-sub">Enterprise grade</div>
</div>
<div class="cs-metric-card cs-red">
<div class="cs-metric-val">Mission Critical</div>
<div class="cs-metric-label">System Level</div>
<div class="cs-metric-sub">Tax compliance system</div>
</div>
</div>
</section>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Architecture</span>
<div class="cs-section-label-line"></div>
<span class="cs-section-label-num">02</span>
</div>
<div class="cs-arch-diagram">
<div class="cs-arch-diagram-inner">

<div class="cs-arch-node cs-source">
<div class="cs-arch-node-icon"></div>
<div class="cs-arch-node-label">Client Apps</div>
<div class="cs-arch-node-sub">REST + MVC clients</div>
</div>

<div class="cs-arch-arrow">
<div class="cs-arch-arrow-line"></div>
<div class="cs-arch-arrow-label">HTTP / JWT</div>
</div>

<div style="display:flex; flex-direction:column; align-items:center; gap:0;">
<div class="cs-arch-node core" style="width:220px;">
<div class="cs-arch-node-label" style="font-size:13px; margin-bottom:10px;">.NET 6.0 Web API</div>
<div class="cs-core-stack">
<div class="cs-core-step"><div class="cs-core-step-dot"></div>API Controllers</div>
<div class="cs-core-step"><div class="cs-core-step-dot"></div>Application Services</div>
<div class="cs-core-step"><div class="cs-core-step-dot" style="background:var(--blue)"></div>Domain / Data Layer</div>
</div>
</div>
<div class="cs-schema-connector" style="margin-top:0;">
<div class="cs-schema-line-v"></div>
<div class="cs-schema-arrow-label">admin MVC</div>
<div class="cs-schema-line-v"></div>
<div class="cs-arch-node cs-schema-node">
<div class="cs-arch-node-label" style="font-size:11px; color: #f59e0b;">Backpanel</div>
<div class="cs-arch-node-sub">ASP.NET Core MVC</div>
</div>
</div>
</div>

<div class="cs-arch-arrow">
<div class="cs-arch-arrow-line"></div>
<div class="cs-arch-arrow-label">MongoDB Driver</div>
</div>

<div class="cs-arch-node cs-output">
<div class="cs-arch-node-icon"></div>
<div class="cs-arch-node-label">MongoDB</div>
<div class="cs-arch-node-sub">Document store</div>
</div>

<div style="display:flex; flex-direction:column; align-items:center; gap:0; margin-left:16px;">
<div class="cs-arch-arrow" style="min-width:40px;">
<div class="cs-arch-arrow-line" style="width:30px;"></div>
<div class="cs-arch-arrow-label">OData</div>
</div>
<div class="cs-arch-node cs-source" style="border-color:rgba(96,165,250,0.3);">
<div class="cs-arch-node-icon"></div>
<div class="cs-arch-node-label">SAP BYD</div>
<div class="cs-arch-node-sub">ERP integration</div>
</div>
</div>

</div>
</div>
</section>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Tech Stack</span>
<div class="cs-section-label-line"></div>
<span class="cs-section-label-num">03</span>
</div>
<div class="cs-impact-wrapper">
<table class="cs-stack-table">
<tbody>
<tr><td class="cs-layer">Runtime</td><td class="cs-tech">.NET 6.0 (C#)</td></tr>
<tr><td class="cs-layer">Web Framework</td><td class="cs-tech">ASP.NET Core Web API + MVC</td></tr>
<tr><td class="cs-layer">Database</td><td class="cs-tech">MongoDB (MongoDB.Driver 2.18)</td></tr>
<tr><td class="cs-layer">Authentication</td><td class="cs-tech">JWT Bearer + Google OAuth</td></tr>
<tr><td class="cs-layer">Mapping</td><td class="cs-tech">AutoMapper 12.0</td></tr>
<tr><td class="cs-layer">API Docs</td><td class="cs-tech">Swashbuckle (Swagger)</td></tr>
<tr><td class="cs-layer">Export</td><td class="cs-tech">CsvHelper 30.0</td></tr>
<tr><td class="cs-layer">ERP Integration</td><td class="cs-tech">SAP Business ByDesign OData</td></tr>
</tbody>
</table>
</div>
</section>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Capabilities</span>
<div class="cs-section-label-line"></div>
<span class="cs-section-label-num">04</span>
</div>
<div class="cs-impact-wrapper">
<table class="cs-stack-table">
<tbody>
<tr><td class="cs-layer">Invoice Sync</td><td class="cs-tech">Bidirectional sync with SAP BYD for customer invoices</td></tr>
<tr><td class="cs-layer">Master Data</td><td class="cs-tech">Customer, supplier, material, company profile management</td></tr>
<tr><td class="cs-layer">Tax Numbering</td><td class="cs-tech">Automated tax number generation and tracking</td></tr>
<tr><td class="cs-layer">Auth</td><td class="cs-tech">JWT-based authentication with token validation</td></tr>
<tr><td class="cs-layer">Admin Panel</td><td class="cs-tech">MVC backpanel with CRUD operations and audit logging</td></tr>
<tr><td class="cs-layer">File Export</td><td class="cs-tech">Download invoices and reports via dedicated endpoints</td></tr>
</tbody>
</table>
</div>
</section>

  </div>

  <Footer />
</Layout>
