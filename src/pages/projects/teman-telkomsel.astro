          </tr>
          <tr>
            <td class="cs-row-label">Access control</td>
            <td class="cs-before">No role separation</td>
            <td class="cs-after">RBAC + IP binding</td>
            <td class="cs-delta">Full audit trail</td>
          </tr>
          <tr>
            <td class="cs-row-label">Scale</td>
            <td class="cs-before">Limited subscribers</td>
            <td class="cs-after">Millions of subscribers</td>
            <td class="cs-delta">Mission Critical</td>
          </tr>
        </tbody>
