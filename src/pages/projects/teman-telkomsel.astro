  <!-- TECH STACK -->
  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-text">Tech Stack</span>
      <div class="cs-section-label-line"></div>
      <span class="cs-section-label-num">05</span>
    </div>
    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr>
            <td class="cs-layer">Language</td>
            <td class="cs-tech">PHP 5.x</td>
          </tr>
          <tr>
            <td class="cs-layer">Framework</td>
            <td class="cs-tech">CodeIgniter 2.1.2</td>
          </tr>
          <tr>
            <td class="cs-layer">Architecture</td>
            <td class="cs-tech">Modular HMVC</td>
          </tr>
          <tr>
            <td class="cs-layer">Database</td>
            <td class="cs-tech">Oracle DB (OCI8) · 36 tables</td>
          </tr>
          <tr>
            <td class="cs-layer">Frontend</td>
            <td class="cs-tech">jQuery · Bootstrap 2 · Flexigrid</td>
          </tr>
          <tr>
            <td class="cs-layer">Excel Processing</td>
            <td class="cs-tech">PHPExcel</td>
          </tr>
          <tr>
            <td class="cs-layer">SMS Gateway</td>
            <td class="cs-tech">Telkomsel SMS Gateway API</td>
          </tr>
          <tr>
            <td class="cs-layer">Scheduling</td>
            <td class="cs-tech">DB-driven cron dispatcher</td>
          </tr>
          <tr>
            <td class="cs-layer">Auth</td>
            <td class="cs-tech">Session-based · IP binding · RBAC</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- FOOTER -->

  </div>

  <Footer />
</Layout>
