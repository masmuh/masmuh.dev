          </tr>
          <tr>
            <td class="cs-row-label">SMS scheduling</td>
            <td class="cs-before">Ad-hoc manual sending</td>
            <td class="cs-after">Cron-driven scheduler</td>
            <td class="cs-delta">Once/daily/weekly/monthly</td>
          </tr>
          <tr>
            <td class="cs-row-label">Member import</td>
            <td class="cs-before">Manual data entry</td>
