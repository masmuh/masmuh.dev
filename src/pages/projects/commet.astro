  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-text">Tech Stack</span>
      <div class="cs-section-label-line"></div>
      <span class="cs-section-label-num">06</span>
    </div>
    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr>
            <td class="cs-layer">Language</td>
            <td class="cs-tech">Oracle PL/SQL</td>
          </tr>
          <tr>
            <td class="cs-layer">Database</td>
            <td class="cs-tech">Oracle Database</td>
          </tr>
          <tr>
            <td class="cs-layer">Protocol</td>
            <td class="cs-tech">SOAP/XML · UTL_HTTP</td>
          </tr>
          <tr>
            <td class="cs-layer">XML Parsing</td>
            <td class="cs-tech">XMLDOM · XMLSequence</td>
          </tr>
          <tr>
            <td class="cs-layer">Messaging</td>
            <td class="cs-tech">SMS Gateway · USSD</td>
          </tr>
          <tr>
            <td class="cs-layer">Architecture</td>
            <td class="cs-tech">PL/SQL Layered (Entry → Biz → Utility)</td>
          </tr>
          <tr>
            <td class="cs-layer">Integration</td>
            <td class="cs-tech">Telkomsel SOAP Infrastructure</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  </div>

  <Footer />
</Layout>
