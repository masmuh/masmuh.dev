---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const customSlugs = [
    "anr", "biogen", "bsci", "commet", "cra", "crm-telkomsel",
    "cxoreport", "ems", "eregis", "insentif-alpha",
    "isms-download-generator", "isms-easehub", "isms-echomail",
    "isms-hawkeye", "isms-nextgen", "kanitax", "logdis",
    "msglowid-cms", "porta-glow", "pos-glowverse", "promat-jkts",
    "reborn-apps", "seller-shop", "teman-telkomsel",
    "transformation-portal", "weis",
  ];
  return projects
    .filter((entry) => !customSlugs.includes(entry.id.replace(".md", "")))
    .map((entry) => ({
      params: { slug: entry.id.replace(".md", "") },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, client, date, description } = entry.data;
---

<Layout title={`${title} — Project Detail`} description={description}>
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <main class="container-page pt-12 pb-4 md:pt-16">
    <article class="reveal mx-auto max-w-3xl">
      <header class="border-b-2 border-ink/10 pb-8">
        <div class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-accent-deep">
          // Project Overview
        </div>
        <h1 class="mt-2 text-[clamp(2rem,5vw,3.5rem)] font-extrabold leading-[1.05] tracking-tight">
          {title}
        </h1>
        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
          {client && (
            <div>
              <div class="text-[0.7rem] font-bold uppercase tracking-widest text-ink-mute">Client</div>
              <div class="mt-1 font-semibold">{client}</div>
            </div>
          )}
          {date && (
            <div>
              <div class="text-[0.7rem] font-bold uppercase tracking-widest text-ink-mute">Date</div>
              <div class="mt-1 font-semibold">{date}</div>
            </div>
          )}
        </div>
        {description && <p class="mt-6 max-w-xl text-[0.95rem] leading-relaxed text-ink-soft">{description}</p>}
      </header>

      <div class="project-content pt-8 pb-16">
        <Content />
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  .project-content {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--color-ink-soft);
  }

  .project-content h1,
  .project-content h2,
  .project-content h3,
  .project-content h4 {
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 3rem 0 1.25rem;
    line-height: 1.2;
  }
  .project-content h1 { font-size: 1.9rem; }
  .project-content h2 { font-size: 1.55rem; }
  .project-content h3 { font-size: 1.25rem; }
  .project-content h4 { font-size: 1.05rem; }

  .project-content p {
    margin-bottom: 1.5rem;
  }

  .project-content strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  .project-content a {
    color: var(--color-accent-deep);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-content ul,
  .project-content ol {
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
  }
  .project-content ul {
    list-style: none;
    padding-left: 0;
  }
  .project-content ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.6rem;
  }
  .project-content ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--color-accent);
  }
  .project-content ol li {
    margin-bottom: 0.6rem;
  }

  .project-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-cloud);
    border: 1.5px solid #d5dbe4;
    border-radius: 0.4rem;
    padding: 0.15rem 0.4rem;
    color: var(--color-accent-deep);
  }

  .project-content pre {
    background: #0e1420;
    border-radius: 1rem;
    padding: 1.5rem;
    margin: 2rem 0;
    overflow-x: auto;
    border: 2px solid var(--color-ink);
  }
  .project-content pre code {
    background: transparent;
    border: none;
    padding: 0;
    color: #d8e1f0;
  }

  .project-content blockquote {
    border-left: 4px solid var(--color-accent);
    padding: 1rem 1.5rem;
    margin: 2rem 0;
    background: var(--color-accent-soft);
    border-radius: 0 0.75rem 0.75rem 0;
    font-style: italic;
    color: var(--color-ink);
  }

  .project-content hr {
    border: none;
    border-top: 2px solid var(--color-ink);
    opacity: 0.08;
    margin: 3rem 0;
  }

  .project-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0 2rem;
    font-size: 0.85rem;
    border: 2px solid var(--color-ink);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .project-content th {
    background: var(--color-cloud);
    color: var(--color-ink);
    font-weight: 800;
    text-align: left;
    padding: 0.7rem 0.9rem;
    border-bottom: 2px solid var(--color-ink);
  }
  .project-content td {
    padding: 0.7rem 0.9rem;
    color: var(--color-ink-soft);
    border-bottom: 1px solid #e5e9f0;
  }
  .project-content tr:last-child td {
    border-bottom: none;
  }
  .project-content tr:hover td {
    background: var(--color-accent-soft);
  }
</style>