---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="ANR Enterprise Bridge - Mas Muhammad" description="A .NET 9.0 background worker service that bridges SAP Business ByDesign with enterprise payment processing. Automates bill payment and tax payment data fetching via OData, processes file transfers over SFTP/FTP, handles callback updates, and sends email notifications — all on cron-driven schedules.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
<div class="cs-hero-meta">
<span class="cs-badge cs-badge-corporate">Corporate</span><span class="cs-badge cs-badge-client">Bank Mandiri</span> 
<span class="cs-badge cs-badge-year">August 2023</span>
</div>
<h1 class="cs-hero-title">ANR <span>Enterprise</span><br>Bridge<span class="cs-cursor"></span></h1>
<p class="cs-hero-desc">
A .NET 9.0 background worker service that bridges SAP Business ByDesign with enterprise payment processing. Automates bill payment and tax payment data fetching via OData, processes file transfers over SFTP/FTP, handles callback updates, and sends email notifications — all on cron-driven schedules.
</p>
<div class="cs-stack-pills">
<span class="cs-stack-pill">C# .NET 9.0</span>
<span class="cs-stack-pill">Windows Service</span>
<span class="cs-stack-pill">LiteDB</span>
<span class="cs-stack-pill">SAP BYD OData</span>
<span class="cs-stack-pill">SFTP/FTP</span>
<span class="cs-stack-pill">MailKit</span>
<span class="cs-stack-pill">Docker</span>
</div>
</header>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Impact</span>
<div class="cs-section-label-line"></div>
<span class="cs-section-label-num">01</span>
</div>
<div class="cs-metrics-grid">
<div class="cs-metric-card">
<div class="cs-metric-val">4,975+</div>
<div class="cs-metric-label">Lines of Code</div>
<div class="cs-metric-sub">C# across 58 files</div>
</div>
<div class="cs-metric-card">
<div class="cs-metric-val">3</div>
<div class="cs-metric-label">Worker Services</div>
<div class="cs-metric-sub">Cron-scheduled jobs</div>
</div>
<div class="cs-metric-card">
<div class="cs-metric-val">9</div>
<div class="cs-metric-label">Service Modules</div>
<div class="cs-metric-sub">Interface-based services</div>
</div>
<div class="cs-metric-card cs-red">
<div class="cs-metric-val">Mission Critical</div>
<div class="cs-metric-label">System Level</div>
<div class="cs-metric-sub">Payment automation</div>
</div>
</div>
</section>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Architecture</span>
<div class="cs-section-label-line"></div>
<span class="cs-section-label-num">02</span>
</div>
<div class="cs-arch-diagram">
<div class="cs-arch-diagram-inner">

<div class="cs-arch-node cs-source">
<div class="cs-arch-node-icon"></div>
<div class="cs-arch-node-label">SAP BYD</div>
<div class="cs-arch-node-sub">OData API</div>
</div>

<div class="cs-arch-arrow">
<div class="cs-arch-arrow-line"></div>
<div class="cs-arch-arrow-label">fetch</div>
</div>

<div style="display:flex; flex-direction:column; align-items:center; gap:0;">
<div class="cs-arch-node core" style="width:220px;">
<div class="cs-arch-node-label" style="font-size:13px; margin-bottom:10px;">.NET 9.0 Worker</div>
<div class="cs-core-stack">
<div class="cs-core-step"><div class="cs-core-step-dot"></div>Worker · Fetch cycle</div>
<div class="cs-core-step"><div class="cs-core-step-dot"></div>Worker · Callback</div>
<div class="cs-core-step"><div class="cs-core-step-dot" style="background:var(--blue)"></div>Worker · Upload</div>
</div>
</div>
<div class="cs-schema-connector" style="margin-top:0;">
<div class="cs-schema-line-v"></div>
<div class="cs-schema-arrow-label">NCrontab Scheduler</div>
<div class="cs-schema-line-v"></div>
<div class="cs-arch-node cs-schema-node">
<div class="cs-arch-node-label" style="font-size:11px; color: #f59e0b;">Service Layer</div>
<div class="cs-arch-node-sub">Fetch · Callback · FTP · Auth · Mail</div>
</div>
</div>
</div>

<div class="cs-arch-arrow">
<div class="cs-arch-arrow-line"></div>
<div class="cs-arch-arrow-label">persist</div>
</div>

<div class="cs-arch-node cs-output">
<div class="cs-arch-node-icon"></div>
<div class="cs-arch-node-label">LiteDB</div>
<div class="cs-arch-node-sub">Embedded document DB</div>
</div>

<div class="cs-arch-arrow" style="min-width:40px;">
<div class="cs-arch-arrow-line" style="width:30px;"></div>
<div class="cs-arch-arrow-label">transfer</div>
</div>

<div class="cs-arch-node cs-source" style="border-color:rgba(245,158,11,0.3);">
<div class="cs-arch-node-icon"></div>
<div class="cs-arch-node-label">SFTP / FTP</div>
<div class="cs-arch-node-sub">File exchange</div>
</div>

<div class="cs-arch-arrow" style="min-width:40px;">
<div class="cs-arch-arrow-line" style="width:30px;"></div>
<div class="cs-arch-arrow-label">notify</div>
</div>

<div class="cs-arch-node cs-output" style="border-color:rgba(96,165,250,0.3);">
<div class="cs-arch-node-icon"></div>
<div class="cs-arch-node-label">Email</div>
<div class="cs-arch-node-sub">SMTP notifications</div>
</div>

</div>
</div>
</section>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Tech Stack</span>
<div class="cs-section-label-line"></div>
<span class="cs-section-label-num">03</span>
</div>
<div class="cs-impact-wrapper">
<table class="cs-stack-table">
<tbody>
<tr><td class="cs-layer">Runtime</td><td class="cs-tech">.NET 9.0 (C# 13)</td></tr>
<tr><td class="cs-layer">Host Model</td><td class="cs-tech">Windows Service + Linux systemd + Docker</td></tr>
<tr><td class="cs-layer">Database</td><td class="cs-tech">LiteDB 5.0 (embedded)</td></tr>
<tr><td class="cs-layer">File Transfer</td><td class="cs-tech">FluentFTP · SSH.NET (SFTP)</td></tr>
<tr><td class="cs-layer">Email</td><td class="cs-tech">MailKit (SMTP via resend.com)</td></tr>
<tr><td class="cs-layer">Logging</td><td class="cs-tech">NLog · Serilog</td></tr>
<tr><td class="cs-layer">ERP Integration</td><td class="cs-tech">SAP Business ByDesign OData</td></tr>
<tr><td class="cs-layer">Scheduling</td><td class="cs-tech">NCrontab.Signed (cron expressions)</td></tr>
</tbody>
</table>
</div>
</section>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Capabilities</span>
<div class="cs-section-label-line"></div>
<span class="cs-section-label-num">04</span>
</div>
<div class="cs-impact-wrapper">
<table class="cs-stack-table">
<tbody>
<tr><td class="cs-layer">Bill Payment</td><td class="cs-tech">Fetch bill payment advice from SAP BYD OData, process and persist locally</td></tr>
<tr><td class="cs-layer">Tax Payment</td><td class="cs-tech">Automated tax payment data extraction and file generation</td></tr>
<tr><td class="cs-layer">File Exchange</td><td class="cs-tech">SFTP/FTP upload of outgoing payment files and download of callback files</td></tr>
<tr><td class="cs-layer">Callback Processing</td><td class="cs-tech">Process payment status callbacks and update SAP via OData</td></tr>
<tr><td class="cs-layer">Inbound Files</td><td class="cs-tech">Read and process incoming payment files (CSV, Excel, text)</td></tr>
<tr><td class="cs-layer">Notifications</td><td class="cs-tech">Automated email notifications via SMTP with HTML templates</td></tr>
</tbody>
</table>
</div>
</section>

  </div>

  <Footer />
</Layout>
