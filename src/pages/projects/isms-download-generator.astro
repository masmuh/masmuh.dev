---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="ISMS Download Generator — Mas Muhammad"
  description="Automated PDF/Excel generation engine for high-volume logistics documentation, handling thousands of labels and manifests daily."
>
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

    <!-- HERO -->
    <header class="cs-hero">
      <div class="cs-hero-meta">
        <span class="cs-badge cs-badge-corporate">Corporate</span>
        <span class="cs-badge cs-badge-client">Sampoerna</span>
        <span class="cs-badge cs-badge-year">2026</span>
      </div>
      <h1 class="cs-hero-title">
        ISMS <span>Download</span><br />Generator<span class="cs-cursor"
        ></span>
      </h1>
      <p class="cs-hero-desc">
        A specialized ETL middleware bridging raw, unstructured telemetry data
        from field devices with centralized enterprise analytics — converting
        high-volume legacy fixed-width streams into structured, audit-ready CSV
        assets for downstream BI consumption.
      </p>
      <div class="cs-stack-pills">
        <span class="cs-stack-pill">.NET Worker</span>
        <span class="cs-stack-pill">Aspose.Words</span>
        <span class="cs-stack-pill">iText7</span>
        <span class="cs-stack-pill">NPOI</span>
        <span class="cs-stack-pill">TPL</span>
        <span class="cs-stack-pill">SQL Server</span>
        <span class="cs-stack-pill">Windows Auth / AD</span>
      </div>
    </header>

    <!-- METRICS -->
    <section class="cs-section">
      <div class="cs-section-label">
        <span class="cs-section-label-text">Impact</span>
        <div class="cs-section-label-line"></div>
        <span class="cs-section-label-num">01</span>
      </div>
      <div class="cs-metrics-grid">
        <div class="cs-metric-card">
          <div class="cs-metric-val">75%</div>
          <div class="cs-metric-label">Data latency reduction</div>
          <div class="cs-metric-sub">Hours → minutes per cycle</div>
        </div>
        <div class="cs-metric-card">
          <div class="cs-metric-val">99.9%</div>
          <div class="cs-metric-label">Error reduction</div>
          <div class="cs-metric-sub">Legacy parsing accuracy</div>
        </div>
        <div class="cs-metric-card cs-metric-amber">
          <div class="cs-metric-val">0</div>
          <div class="cs-metric-label">Code changes for schema update</div>
          <div class="cs-metric-sub">Via DB entry only</div>
        </div>
        <div class="cs-metric-card cs-metric-amber">
          <div class="cs-metric-val">25×</div>
          <div class="cs-metric-label">Parallel batch size</div>
          <div class="cs-metric-sub">Predictable memory footprint</div>
        </div>
      </div>
    </section>

    <!-- ARCHITECTURE -->
    <section class="cs-section">
      <div class="cs-section-label">
        <span class="cs-section-label-text">Architecture</span>
        <div class="cs-section-label-line"></div>
        <span class="cs-section-label-num">02</span>
      </div>
      <div class="cs-arch-diagram">
        <div class="cs-arch-diagram-inner">
          <div class="cs-arch-node cs-arch-source">
            <div class="cs-arch-node-icon"></div>
            <div class="cs-arch-node-label">File Share</div>
            <div class="cs-arch-node-sub">ZIP archives</div>
          </div>

          <div class="cs-arch-arrow">
            <div class="cs-arch-arrow-line"></div>
            <div class="cs-arch-arrow-label">batch scan</div>
          </div>

          <div class="cs-arch-core-wrap">
            <div class="cs-arch-node cs-arch-core">
              <div
                class="cs-arch-node-label"
                style="font-size:13px; margin-bottom:10px;"
              >
                .NET Worker Service
              </div>
              <div class="cs-core-stack">
                <div class="cs-core-step">
                  <div class="cs-core-step-dot"></div>
                  Cron trigger · batch scanner
                </div>
                <div class="cs-core-step">
                  <div class="cs-core-step-dot"></div>
                  TPL parser · Parallel.ForEach
                </div>
                <div class="cs-core-step">
                  <div
                    class="cs-core-step-dot"
                    style="background:var(--isms-blue)"
                  >
                  </div>
                  CSV writer · audit trail
                </div>
              </div>
            </div>
            <div class="cs-schema-connector">
              <div class="cs-schema-line-v"></div>
              <div class="cs-schema-arrow-label">schema-on-read</div>
              <div class="cs-schema-line-v"></div>
              <div class="cs-arch-node cs-schema-node">
                <div class="cs-arch-node-label">SQL Server</div>
                <div class="cs-arch-node-sub">Schema metadata</div>
              </div>
            </div>
          </div>

          <div class="cs-arch-arrow">
            <div class="cs-arch-arrow-line"></div>
            <div class="cs-arch-arrow-label">structured CSV</div>
          </div>

          <div class="cs-arch-node cs-arch-output">
            <div class="cs-arch-node-icon"></div>
            <div class="cs-arch-node-label">S3 Storage</div>
            <div class="cs-arch-node-sub">AYO HERO</div>
          </div>
        </div>
      </div>
    </section>

    <!-- DECISIONS -->
    <section class="cs-section">
      <div class="cs-section-label">
        <span class="cs-section-label-text">Decision Log</span>
        <div class="cs-section-label-line"></div>
        <span class="cs-section-label-num">03</span>
      </div>
      <div class="cs-decision-list">
        <div class="cs-decision-card">
          <div class="cs-decision-header">
            <div class="cs-decision-num">01</div>
            <div>
              <div class="cs-decision-title">
                Schema Management — Metadata-Driven Mapping
              </div>
              <div class="cs-decision-problem">
                Hard-coding parsing logic for every proprietary format creates
                maintenance debt that compounds with every new region or format
                version.
              </div>
            </div>
          </div>
          <div class="cs-decision-body">
            <div>
              <div class="cs-decision-col-label cs-decision-chosen">
                ▸ Chosen
              </div>
              <div class="cs-decision-col-text">
                Schema-on-read pattern powered by SQL Server metadata tables.
                Field mappings and column lengths are stored as rows — updatable
                without a single line of code change or CI/CD cycle.
              </div>
            </div>
            <div>
              <div class="cs-decision-col-label cs-decision-tradeoff">
                ▸ Trade-off
              </div>
              <div class="cs-decision-col-text">
                Slight runtime overhead when fetching mapping rules at startup —
                accepted because the ROI in maintenance agility is massive
                across a fleet of constantly-evolving regional formats.
              </div>
            </div>
          </div>
          <div class="cs-decision-code">
            <pre><span class="cs-token-cm">//  Before: hard-coded regional logic</span>
<span class="cs-token-kw">if</span> (region == <span class="cs-token-str">"JAWA"</span>) ParseFormatA(line);
<span class="cs-token-kw">else if</span> (region == <span class="cs-token-str">"BALI"</span>) ParseFormatB(line);

<span class="cs-token-cm">//  After: schema-on-read</span>
<span class="cs-token-kw">var</span> schema = <span class="cs-token-fn">_schemaRepo.GetMapping</span>(region, version);
<span class="cs-token-kw">var</span> record = <span class="cs-token-fn">_parser.Parse</span>(line, schema);</pre>
          </div>
        </div>

        <div class="cs-decision-card">
          <div class="cs-decision-header">
            <div class="cs-decision-num">02</div>
            <div>
              <div class="cs-decision-title">
                Processing Model — Aggressive Parallelism (TPL)
              </div>
              <div class="cs-decision-problem">
                Sequential processing of thousands of ZIP archives created an
                unacceptable bottleneck in the daily reporting cycle.
              </div>
            </div>
          </div>
          <div class="cs-decision-body">
            <div>
              <div class="cs-decision-col-label cs-decision-chosen">
                ▸ Chosen
              </div>
              <div class="cs-decision-col-text">
                Task Parallel Library (TPL) with Parallel.ForEach + 25-file
                batch increments. CPU saturation maximized while memory
                footprint remains bounded and predictable.
              </div>
            </div>
            <div>
              <div class="cs-decision-col-label cs-decision-tradeoff">
                ▸ Trade-off
              </div>
              <div class="cs-decision-col-text">
                Increased memory pressure under high concurrency — mitigated by
                batch-based recursive processing. Each batch runs full GC at
                completion, preventing heap bloat during sustained throughput.
              </div>
            </div>
          </div>
          <div class="cs-decision-code">
            <pre><span class="cs-token-kw">var</span> batches = archives.<span class="cs-token-fn">Chunk</span>(<span class="cs-token-acc">25</span>);

<span class="cs-token-kw">foreach</span> (<span class="cs-token-kw">var</span> batch <span class="cs-token-kw">in</span> batches)
&#123;
    <span class="cs-token-fn">Parallel.ForEach</span>(batch, archive =&gt;
    &#123;
        <span class="cs-token-kw">var</span> records = <span class="cs-token-fn">ExtractAndParse</span>(archive);
        <span class="cs-token-fn">WriteToCsv</span>(records);
    &#125;);
    GC.<span class="cs-token-fn">Collect</span>(); <span class="cs-token-cm">// predictable GC at batch boundaries</span>
&#125;</pre>
          </div>
        </div>

        <div class="cs-decision-card">
          <div class="cs-decision-header">
            <div class="cs-decision-num">03</div>
            <div>
              <div class="cs-decision-title">
                Auth Strategy — Integrated Windows Authentication
              </div>
              <div class="cs-decision-problem">
                System operates within a highly secured corporate DMZ —
                authentication must be zero-friction for the ops team while
                maintaining strict access control.
              </div>
            </div>
          </div>
          <div class="cs-decision-body">
            <div>
              <div class="cs-decision-col-label cs-decision-chosen">
                ▸ Chosen
              </div>
              <div class="cs-decision-col-text">
                Integrated Windows Security for AuthN/AuthZ via Active
                Directory. Zero credential management overhead — the existing AD
                infrastructure handles identity completely.
              </div>
            </div>
            <div>
              <div class="cs-decision-col-label cs-decision-tradeoff">
                ▸ Trade-off
              </div>
              <div class="cs-decision-col-text">
                Less flexible than modern OAuth2/OIDC patterns. Accepted: the
                reduced attack surface and operational simplicity outweigh
                flexibility concerns in this closed corporate DMZ context.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BUSINESS IMPACT -->
    <section class="cs-section">
      <div class="cs-section-label">
        <span class="cs-section-label-text">Business Impact</span>
        <div class="cs-section-label-line"></div>
        <span class="cs-section-label-num">04</span>
      </div>
      <div class="cs-impact-wrapper">
        <table class="cs-impact-table">
          <thead>
            <tr>
              <th>Metric</th>
              <th>Before</th>
              <th>After</th>
              <th>Delta</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="cs-row-label">Daily reporting cycle</td>
              <td class="cs-before">Hours</td>
              <td class="cs-after">Minutes</td>
              <td class="cs-delta">↓ 75% latency</td>
            </tr>
            <tr>
              <td class="cs-row-label">Legacy parsing errors</td>
              <td class="cs-before">High (manual)</td>
              <td class="cs-after">Near-zero</td>
              <td class="cs-delta">↓ 99.9% errors</td>
            </tr>
            <tr>
              <td class="cs-row-label">Schema change cycle</td>
              <td class="cs-before">Full CI/CD deploy</td>
              <td class="cs-after">DB entry update</td>
              <td class="cs-delta">0 code changes</td>
            </tr>
            <tr>
              <td class="cs-row-label">Audit compliance</td>
              <td class="cs-before">Manual reconciliation</td>
              <td class="cs-after">Auto-persistent logs</td>
              <td class="cs-delta">100% traceable</td>
            </tr>
            <tr>
              <td class="cs-row-label">Seasonal scaling</td>
              <td class="cs-before">Architectural refactor</td>
              <td class="cs-after">Add compute node</td>
              <td class="cs-delta">Stateless horizontal</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- TECH STACK -->
    <section class="cs-section">
      <div class="cs-section-label">
        <span class="cs-section-label-text">Tech Stack</span>
        <div class="cs-section-label-line"></div>
        <span class="cs-section-label-num">05</span>
      </div>
      <div class="cs-impact-wrapper">
        <table class="cs-stack-table">
          <tbody>
            <tr>
              <td class="cs-layer">Runtime</td>
              <td class="cs-tech">.NET Worker Service</td>
            </tr>
            <tr>
              <td class="cs-layer">Document Gen</td>
              <td class="cs-tech">Aspose.Words · iText7 · NPOI · EPPlus</td>
            </tr>
            <tr>
              <td class="cs-layer">Parallelism</td>
              <td class="cs-tech">TPL · Parallel.ForEach · Task</td>
            </tr>
            <tr>
              <td class="cs-layer">Database</td>
              <td class="cs-tech">SQL Server (schema metadata + audit log)</td
              >
            </tr>
            <tr>
              <td class="cs-layer">Auth</td>
              <td class="cs-tech"
                >Windows Integrated Auth · Active Directory</td
              >
            </tr>
            <tr>
              <td class="cs-layer">Storage</td>
              <td class="cs-tech">Network File Share (SMB) · ZIP archives</td>
            </tr>
            <tr>
              <td class="cs-layer">Output</td>
              <td class="cs-tech">Structured CSV → downstream BI pipeline</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    </div>

  <Footer />
</Layout>
