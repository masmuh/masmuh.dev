---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Biogen SAP Integration - Mas Muhammad" description="A focused .NET 5.0 background worker service that automates SAP Business ByDesign OData integration. Runs on a configurable timer (hourly), queries customer quote items missing product descriptions, fetches material master data with pagination, cross-references products to quotes, and patches each quote item with the corresponding long description from the material master.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
    <div class="cs-hero-meta">
      <span class="cs-badge cs-badge-corporate">Corporate</span><span class="cs-badge cs-badge-client">Biogen</span> 
      <span class="cs-badge cs-badge-year">July 2021</span>
    </div>
    <h1 class="cs-hero-title">Biogen SAP Integration<br><span>SAP ByDesign OData Automation Worker</span></h1>
    <p class="cs-hero-desc">A focused .NET 5.0 background worker service that automates SAP Business ByDesign OData integration. Runs on a configurable timer (hourly), queries customer quote items missing product descriptions, fetches material master data with pagination, cross-references products to quotes, and patches each quote item with the corresponding long description from the material master.</p>
    <div class="cs-stack-pills">
      <span class="cs-stack-pill">.NET 5</span><span class="cs-stack-pill">Worker Service</span><span class="cs-stack-pill">IHostedService</span><span class="cs-stack-pill">OData REST</span><span class="cs-stack-pill">SAP ByDesign</span><span class="cs-stack-pill">Newtonsoft.Json</span><span class="cs-stack-pill">Timer Scheduler</span>
    </div>
  </header>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">01</span>
      <span class="cs-section-label-text">Impact &amp; Metrics</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-metrics-grid">
      <div class="cs-metric-card cs-amber"><div class="cs-metric-val">365</div><div class="cs-metric-label">Lines of Code</div><div class="cs-metric-sub">C# — 11 source files</div></div>
      <div class="cs-metric-card cs-blue"><div class="cs-metric-val">1</div><div class="cs-metric-label">Background Worker</div><div class="cs-metric-sub">Timer-based, single-concurrency</div></div>
      <div class="cs-metric-card cs-amber"><div class="cs-metric-val">3</div><div class="cs-metric-label">OData Endpoints</div><div class="cs-metric-sub">Quote Items, Materials, PATCH update</div></div>
      <div class="cs-metric-card cs-amber"><div class="cs-metric-val">2</div><div class="cs-metric-label">Complexity Rating</div><div class="cs-metric-sub">Utility/Tool</div></div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">02</span>
      <span class="cs-section-label-text">Architecture</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-arch-diagram">
      <div class="cs-arch-diagram-inner">
        <div class="cs-arch-node cs-db-node">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Timer Trigger</div>
          <div class="cs-arch-node-sub">Every 60 min</div>
        </div>
        <div class="cs-arch-arrow"><div class="cs-arch-arrow-line"></div><div class="cs-arch-arrow-label">fires</div></div>
        <div class="cs-arch-node core">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Worker Service</div>
          <div class="cs-arch-node-sub">.NET 5 · IHostedService</div>
          <div class="cs-core-stack">
            <div class="cs-core-step"><span class="cs-core-step-dot"></span>Fetch empty quote items (GET)</div>
            <div class="cs-core-step"><span class="cs-core-step-dot cs-blue"></span>Fetch material master (GET paginated)</div>
            <div class="cs-core-step"><span class="cs-core-step-dot"></span>Cross-reference & PATCH update</div>
          </div>
        </div>
        <div class="cs-arch-arrow"><div class="cs-arch-arrow-line"></div><div class="cs-arch-arrow-label">OData</div></div>
        <div class="cs-arch-node"><div class="cs-arch-node-icon"></div><div class="cs-arch-node-label">SAP ByDesign</div><div class="cs-arch-node-sub">wiyasa_customerquote</div></div>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">03</span>
      <span class="cs-section-label-text">Key Capabilities</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-cap-list">
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Query quote items with missing ProductDetailDescription_SDK</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Fetch material master catalog with paginated OData</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Cross-reference products to quotes by InternalID</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>PATCH each quote item with long description</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>CSRF token handling for SAP PATCH requests</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Timer-based scheduling with concurrency limiter</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Structured logging with ILogger</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>IOptions configuration for tenant &amp; interval</div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">04</span>
      <span class="cs-section-label-text">Tech Stack</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-arch-diagram">
      <table class="cs-stack-table">
        <tr><td class="cs-layer">Runtime</td><td class="cs-tech">.NET 5.0, Microsoft.Extensions.Hosting</td></tr>
        <tr><td class="cs-layer">Pattern</td><td class="cs-tech">Background Worker Service, IHostedService, Timer-based scheduling</td></tr>
        <tr><td class="cs-layer">SAP Integration</td><td class="cs-tech">OData REST (GET/PATCH), CSRF token, Basic Auth, Paginated queries</td></tr>
        <tr><td class="cs-layer">Serialization</td><td class="cs-tech">Newtonsoft.Json 13.0</td></tr>
        <tr><td class="cs-layer">Configuration</td><td class="cs-tech">IOptions, appsettings.json (Tenant, SchedulerInterval)</td></tr>
        <tr><td class="cs-layer">Concurrency</td><td class="cs-tech">StateOfJobSession (static counter, max 1 active job)</td></tr>
      </table>
    </div>
  </section>

  </div>

  <Footer />
</Layout>
