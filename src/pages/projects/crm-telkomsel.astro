---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="CRM Telkomsel - Mas Muhammad" description="An internal employee CRM portal for Telkomsel featuring news and highlights management, employee survey and quiz system, and a full admin backend. Built with classic ASP.NET WebForms 3.5 on .NET Framework backed by SQL Server.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
    <div class="cs-hero-meta">
      <span class="cs-badge cs-badge-corporate">Corporate</span><span class="cs-badge cs-badge-client">Telkomsel</span> 
      <span class="cs-badge cs-badge-year">August 2013</span>
    </div>
    <h1 class="cs-hero-title">
      CRM Telkomsel<br>
      <span>Internal Portal</span>
    </h1>
    <p class="cs-hero-desc">
      An internal employee CRM portal for Telkomsel featuring news and highlights management,
      employee survey and quiz system, and a full admin backend. Built with classic ASP.NET
      WebForms 3.5 on .NET Framework backed by SQL Server.
    </p>
    <div class="cs-stack-pills">
      <span class="cs-stack-pill">ASP.NET WebForms 3.5</span>
      <span class="cs-stack-pill">C#</span>
      <span class="cs-stack-pill">SQL Server</span>
      <span class="cs-stack-pill">jQuery 1.10</span>
      <span class="cs-stack-pill">Bootstrap 3</span>
      <span class="cs-stack-pill">Metronic Theme</span>
    </div>
  </header>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">01</span>
      <span class="cs-section-label-text">Impact &amp; Metrics</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-metrics-grid">
      <div class="cs-metric-card">
        <div class="cs-metric-val">7.9K+</div>
        <div class="cs-metric-label">Lines of Code</div>
        <div class="cs-metric-sub">C# + ASPX markup</div>
      </div>
      <div class="cs-metric-card cs-amber">
        <div class="cs-metric-val">10K+</div>
        <div class="cs-metric-label">Employees Served</div>
        <div class="cs-metric-sub">Telkomsel internal users</div>
      </div>
      <div class="cs-metric-card">
        <div class="cs-metric-val">3</div>
        <div class="cs-metric-label">Database Tables</div>
        <div class="cs-metric-sub">CRM_HIGHLIGHT, CRM_SURVEY, CRM_SURVEY_DETAIL</div>
      </div>
    </div>

    <div class="cs-impact-wrapper" style="margin-top:20px;">
      <table class="cs-impact-table">
        <thead>
          <tr>
            <th>Area</th>
            <th>Before</th>
            <th>After</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="cs-row-label">News Distribution</td>
            <td class="cs-before">Email blasts, no archive</td>
            <td class="cs-after">Centralized portal with searchable archive</td>
            <td class="cs-delta">+ unified</td>
          </tr>
          <tr>
            <td class="cs-row-label">Employee Surveys</td>
            <td class="cs-before">Paper-based, manual tally</td>
            <td class="cs-after">Digital quiz system with auto-scoring</td>
            <td class="cs-delta">+ automated</td>
          </tr>
          <tr>
            <td class="cs-row-label">Admin Workflow</td>
            <td class="cs-before">No standardized backend</td>
            <td class="cs-after">Login-protected admin dashboard</td>
            <td class="cs-delta">+ secured</td>
          </tr>
          <tr>
            <td class="cs-row-label">Leadership Comms</td>
            <td class="cs-before">Limited reach</td>
            <td class="cs-after">Direct channel to 10K+ employees</td>
            <td class="cs-delta">+ scaled</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">02</span>
      <span class="cs-section-label-text">Architecture</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-arch-diagram">
      <div class="cs-arch-diagram-inner">
        <div class="cs-arch-node cs-source">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">ASPX Pages</div>
          <div class="cs-arch-node-sub">Public + Admin</div>
        </div>
        <div class="cs-arch-arrow">
          <div class="cs-arch-arrow-line"></div>
          <div class="cs-arch-arrow-label">postback</div>
        </div>
        <div class="cs-arch-node core">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Code-Behind</div>
          <div class="cs-arch-node-sub">C# .NET 3.5</div>
          <div class="cs-core-stack">
            <div class="cs-core-step">
              <span class="cs-core-step-dot"></span>
              Page_Load — auth &amp; data binding
            </div>
            <div class="cs-core-step">
              <span class="cs-core-step-dot"></span>
              Button clicks — CRUD operations
            </div>
            <div class="cs-core-step">
              <span class="cs-core-step-dot"></span>
              Raw ADO.NET — SqlConnection, SqlCommand
            </div>
          </div>
        </div>
        <div class="cs-arch-arrow">
          <div class="cs-arch-arrow-line"></div>
          <div class="cs-arch-arrow-label">T-SQL</div>
        </div>
        <div class="cs-arch-node cs-output">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">SQL Server</div>
          <div class="cs-arch-node-sub">3 tables</div>
        </div>
      </div>
    </div>

    <div style="margin-top:20px; display:flex; align-items:center; gap:12px; flex-wrap:wrap; justify-content:center;">
      <div class="cs-arch-node cs-schema-node">
        <div class="cs-arch-node-icon"></div>
        <div class="cs-arch-node-label">CRM_HIGHLIGHT</div>
        <div class="cs-arch-node-sub">news content</div>
      </div>
      <div class="cs-schema-connector">
        <span class="cs-schema-arrow-label">+</span>
      </div>
      <div class="cs-arch-node cs-schema-node">
        <div class="cs-arch-node-icon"></div>
        <div class="cs-arch-node-label">CRM_SURVEY</div>
        <div class="cs-arch-node-sub">quiz master</div>
      </div>
      <div class="cs-schema-connector">
        <span class="cs-schema-arrow-label">+</span>
      </div>
      <div class="cs-arch-node cs-schema-node">
        <div class="cs-arch-node-icon"></div>
        <div class="cs-arch-node-label">CRM_SURVEY_DETAIL</div>
        <div class="cs-arch-node-sub">responses</div>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">03</span>
      <span class="cs-section-label-text">Decision Log</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-decision-list">

      <div class="cs-decision-card">
        <div class="cs-decision-header">
          <span class="cs-decision-num">01</span>
          <div>
            <div class="cs-decision-title">Why Classic WebForms Instead of MVC</div>
            <div class="cs-decision-problem">At the time (2013), the team's expertise was in WebForms and the .NET 3.5 runtime was already deployed on Telkomsel's servers. MVC 4 was available but would have required runtime upgrades and a steeper learning curve for the maintenance team.</div>
          </div>
        </div>
        <div class="cs-decision-body">
          <div>
            <div class="cs-decision-col-label cs-chosen"> Chosen — WebForms</div>
            <div class="cs-decision-col-text">Leveraged existing server infrastructure (IIS 7, .NET 3.5). Team was productive immediately. ViewState handled form state across postbacks with zero additional JavaScript for basic CRUD. Metronic theme provided ready-made WebForms templates.</div>
          </div>
          <div>
            <div class="cs-decision-col-label cs-tradeoff">△ Tradeoff — MVC</div>
            <div class="cs-decision-col-text">Cleaner separation of concerns, better testability, and lighter page markup. But required .NET 4.0+ runtime, new routing configuration, and retraining the internal maintenance team. Risk of delayed delivery.</div>
          </div>
        </div>
        <div class="cs-decision-code">
<pre><span class="cs-token-cm">// Code-behind pattern used across all pages</span>
<span class="cs-token-kw">protected void</span> <span class="cs-token-fn">Page_Load</span>(<span class="cs-token-kw">object</span> sender, EventArgs e)
&#123;
    <span class="cs-token-kw">if</span> (!IsPostBack) &#123; <span class="cs-token-fn">BindHighlights</span>(); &#125;
&#125;

<span class="cs-token-kw">private void</span> <span class="cs-token-fn">BindHighlights</span>()
&#123;
    <span class="cs-token-kw">using</span> (<span class="cs-token-kw">var</span> conn = <span class="cs-token-kw">new</span> SqlConnection(<span class="cs-token-str">"..."</span>))
    &#123;
        <span class="cs-token-kw">var</span> cmd = <span class="cs-token-kw">new</span> SqlCommand(<span class="cs-token-str">"SELECT * FROM CRM_HIGHLIGHT ORDER BY CREATED_DATE DESC"</span>, conn);
        conn.Open();
        rptHighlights.DataSource = cmd.<span class="cs-token-fn">ExecuteReader</span>();
        rptHighlights.DataBind();
    &#125;
&#125;</pre>
        </div>
      </div>

      <div class="cs-decision-card">
        <div class="cs-decision-header">
          <span class="cs-decision-num">02</span>
          <div>
            <div class="cs-decision-title">Raw ADO.NET vs Entity Framework</div>
            <div class="cs-decision-problem">EF 4.x was available but considered heavy for a 3-table schema. The project had only three database tables; introducing an ORM felt like over-engineering.</div>
          </div>
        </div>
        <div class="cs-decision-body">
          <div>
            <div class="cs-decision-col-label cs-chosen"> Chosen — ADO.NET (raw)</div>
            <div class="cs-decision-col-text">Direct SqlConnection / SqlCommand calls kept full control over T-SQL. No additional assembly references. Queries were simple and readable. Perfect fit for the small schema size and modest data volume.</div>
          </div>
          <div>
            <div class="cs-decision-col-label cs-tradeoff">△ Tradeoff — EF 4.x</div>
            <div class="cs-decision-col-text">Would have added abstraction overhead and required .NET 4.0. Mapping three tables through an ORM added complexity without proportional benefit. Risk of generated SQL being suboptimal for the reporting queries.</div>
          </div>
        </div>
        <div class="cs-decision-code">
<pre><span class="cs-token-cm">// All data access — inline in code-behind</span>
<span class="cs-token-kw">using</span> (<span class="cs-token-kw">var</span> conn = <span class="cs-token-kw">new</span> SqlConnection(cs))
<span class="cs-token-kw">using</span> (<span class="cs-token-kw">var</span> cmd = <span class="cs-token-kw">new</span> SqlCommand(<span class="cs-token-str">"INSERT INTO CRM_SURVEY (...) VALUES (...)"</span>, conn))
&#123;
    conn.Open();
    cmd.<span class="cs-token-fn">ExecuteNonQuery</span>();
&#125;</pre>
        </div>
      </div>

      <div class="cs-decision-card">
        <div class="cs-decision-header">
          <span class="cs-decision-num">03</span>
          <div>
            <div class="cs-decision-title">Metronic Admin Theme as UI Foundation</div>
            <div class="cs-decision-problem">Building a custom admin UI from scratch would have taken weeks. The team needed a professional-looking internal portal that felt modern for its time (2013–2015).</div>
          </div>
        </div>
        <div class="cs-decision-body">
          <div>
            <div class="cs-decision-col-label cs-chosen"> Chosen — Metronic Theme</div>
            <div class="cs-decision-col-text">Provided a polished, responsive admin dashboard out of the box. Included Bootstrap 3, Font Awesome, and jQuery. Reduced UI development time by ~60%. The theme's component library (tables, forms, modals) matched the project's CRUD needs perfectly.</div>
          </div>
          <div>
            <div class="cs-decision-col-label cs-tradeoff">△ Tradeoff — Custom UI</div>
            <div class="cs-decision-col-text">Full design control and no third-party dependency. However, would have required significant front-end effort from a team primarily focused on back-end development. Risk of inconsistent visual quality.</div>
          </div>
        </div>
        <div class="cs-decision-code">
<pre><span class="cs-token-cm">&lt;%-- Metronic-based admin layout --%&gt;</span>
&lt;asp:Content ID=<span class="cs-token-str">"BodyContent"</span> ContentPlaceHolderID=<span class="cs-token-str">"MainContent"</span> runat=<span class="cs-token-str">"server"</span>&gt;
  &lt;div class=<span class="cs-token-str">"page-content"</span>&gt;
    &lt;h3 class=<span class="cs-token-str">"page-title"</span>&gt;Manage Highlights&lt;/h3&gt;
    &lt;div class=<span class="cs-token-str">"portlet box green"</span>&gt;
      <span class="cs-token-cm">&lt;!-- Metronic portlet framework for CRUD forms --&gt;</span>
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/asp:Content&gt;</pre>
        </div>
      </div>

    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">04</span>
      <span class="cs-section-label-text">Tech Stack</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-arch-diagram">
      <table class="cs-stack-table">
        <tr>
          <td class="cs-layer">Frontend</td>
          <td class="cs-tech">ASPX (WebForms markup), jQuery 1.10, Bootstrap 3, Metronic Theme, Font Awesome</td>
        </tr>
        <tr>
          <td class="cs-layer">Backend</td>
          <td class="cs-tech">C# 3.0, .NET Framework 3.5, ASP.NET WebForms code-behind</td>
        </tr>
        <tr>
          <td class="cs-layer">Database</td>
          <td class="cs-tech">SQL Server (T-SQL), raw ADO.NET (SqlConnection, SqlCommand, SqlDataReader)</td>
        </tr>
        <tr>
          <td class="cs-layer">IDE &amp; Tooling</td>
          <td class="cs-tech">Visual Studio 2012, SQL Server Management Studio</td>
        </tr>
        <tr>
          <td class="cs-layer">Server</td>
          <td class="cs-tech">IIS 7 on Windows Server, .NET 3.5 runtime</td>
        </tr>
        <tr>
          <td class="cs-layer">Auth</td>
          <td class="cs-tech">ASP.NET Forms Authentication with custom login page</td>
        </tr>
      </table>
    </div>
  </section>

  </div>

  <Footer />
</Layout>
