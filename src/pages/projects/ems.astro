          <div class="cs-arch-node cs-source">
            <div class="cs-arch-node-icon"></div>
            <div class="cs-arch-node-label">Browser</div>
            <div class="cs-arch-node-sub">Kendo UI + TinyMCE + jQuery</div>
          </div>
          <div class="cs-arch-arrow">
            <div class="cs-arch-arrow-line"></div>
            <div class="cs-arch-arrow-label">HTTP</div>
          </div>
          <div class="cs-arch-node core">
            <div class="cs-arch-node-icon"></div>
            <div class="cs-arch-node-label">MVC 5 + Web API 2</div>
            <div class="cs-arch-node-sub">85 Controllers · SimpleInjector DI</div>
            <div class="cs-core-stack">
              <div class="cs-core-step">
                <span class="cs-core-step-dot"></span>
                Presentation — Razor + Kendo UI
              </div>
              <div class="cs-core-step">
                <span class="cs-core-step-dot cs-blue"></span>
                BLL — 80+ Service Classes
              </div>
              <div class="cs-core-step">
                <span class="cs-core-step-dot cs-amber"></span>
                DAL — Generic Repo + Unit of Work
              </div>
            </div>
          </div>
          <div class="cs-arch-arrow">
            <div class="cs-arch-arrow-line"></div>
            <div class="cs-arch-arrow-label">queries</div>
          </div>
          <div class="cs-arch-node cs-output">
            <div class="cs-arch-node-icon"></div>
            <div class="cs-arch-node-label">SQL Server</div>
