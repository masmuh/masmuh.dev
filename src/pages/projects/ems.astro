          <div class="cs-metric-label">MVC Controllers</div>
          <div class="cs-metric-sub">1,363+ action methods</div>
        </div>
        <div class="cs-metric-card cs-blue">
          <div class="cs-metric-val">130+</div>
          <div class="cs-metric-label">Database Entities</div>
          <div class="cs-metric-sub">EF EDMX + 460 SQL migrations</div>
        </div>
        <div class="cs-metric-card cs-red">
          <div class="cs-metric-val">10</div>
          <div class="cs-metric-label">Complexity Rating</div>
          <div class="cs-metric-sub">Mission Critical — Government Compliance</div>
