        <div class="cs-arch-node cs-db-node">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Quartz.NET</div>
          <div class="cs-arch-node-sub">Windows Service Scheduler</div>
        </div>
        <div class="cs-arch-arrow" style="min-width:40px;">
          <div class="cs-arch-arrow-line" style="width:20px;"></div>
          <div class="cs-arch-arrow-label">XML</div>
        </div>
        <div class="cs-arch-node cs-db-node">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">SAP ByDesign</div>
          <div class="cs-arch-node-sub">STO · GI · GR · TF</div>
        </div>
        <div class="cs-arch-arrow" style="min-width:40px;">
          <div class="cs-arch-arrow-line" style="width:20px;"></div>
          <div class="cs-arch-arrow-label">ETL</div>
        </div>
        <div class="cs-arch-node cs-db-node">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Crystal Reports</div>
