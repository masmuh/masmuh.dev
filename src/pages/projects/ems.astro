    </section>

    <section class="cs-section">
      <div class="cs-section-label">
        <span class="cs-section-label-num">03</span>
        <span class="cs-section-label-text">Key Capabilities</span>
        <span class="cs-section-label-line"></span>
      </div>

      <div class="cs-cap-list">
        <div class="cs-cap-item">
          <span class="cs-cap-icon"></span>
          CK-4C excise document lifecycle — create, approve, government approval
        </div>
        <div class="cs-cap-item">
          <span class="cs-cap-icon"></span>
          CK-5 material movement tracking (domestic, import, export, waste)
        </div>
        <div class="cs-cap-item">
          <span class="cs-cap-icon"></span>
          PBCK-1 quota management and monitoring
        </div>
        <div class="cs-cap-item">
          <span class="cs-cap-icon"></span>
          LACK-1/LACK-2/LACK-10 deficiency notes and reconciliation
        </div>
        <div class="cs-cap-item">
          <span class="cs-cap-icon"></span>
          Excise payment &amp; billing — DJBC billing, payment orders, recap
        </div>
        <div class="cs-cap-item">
          <span class="cs-cap-icon"></span>
          Brand registration (new, update HJE) with SKEP tariff determination
        </div>
        <div class="cs-cap-item">
          <span class="cs-cap-icon"></span>
          Manufacturing license — applications, interviews, SKEP issuance
        </div>
        <div class="cs-cap-item">
          <span class="cs-cap-icon"></span>
          SAP ByDesign integration via XML messaging
        </div>
        <div class="cs-cap-item">
          <span class="cs-cap-icon"></span>
          Multi-level workflow — POA, Controller, Government approval
        </div>
        <div class="cs-cap-item">
          <span class="cs-cap-icon"></span>
          Crystal Reports + Excel + PDF with QR/barcode generation
        </div>
        <div class="cs-cap-item">
          <span class="cs-cap-icon"></span>
          Stuffing plan, SO page, inventory movement tracking
        </div>
