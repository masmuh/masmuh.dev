            <tr>
              <td class="cs-row-label">Excise Document Submission</td>
              <td class="cs-before">Paper-based, manual DJBC submission</td>
              <td class="cs-after">Full electronic CK/PBCK/LACK/BACK lifecycle with government approval workflow</td>
              <td class="cs-delta">+ fully digital</td>
            </tr>
            <tr>
              <td class="cs-row-label">SAP Integration</td>
              <td class="cs-before">Manual data entry, reconciliation delays</td>
              <td class="cs-after">Automated XML inbound/outbound for STO, GI, GR, TF transactions</td>
              <td class="cs-delta">+ real-time sync</td>
            </tr>
            <tr>
              <td class="cs-row-label">Reporting</td>
              <td class="cs-before">Manual spreadsheets, compliance risk</td>
              <td class="cs-after">Crystal Reports + RDLC + Excel/PDF with QR codes</td>
              <td class="cs-delta">+ audit-ready</td>
            </tr>
            <tr>
              <td class="cs-row-label">Manufacturing License</td>
              <td class="cs-before">Paper applications, months per approval</td>
              <td class="cs-after">Digital workflow — applications, interviews, SKEP issuance</td>
              <td class="cs-delta">+ 60% faster</td>
            </tr>
