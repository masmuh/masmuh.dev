---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="EMS Enterprise Suite - Mas Muhammad" description="A government-regulated excise compliance platform built for PT Sampoerna — Indonesia&apos;s largest tobacco manufacturer. Manages the complete lifecycle of excisable goods: electronic excise document submission (CK-1 through CK-5, PBCK series, LACK series), excise payment and billing, brand registration, manufacturing licenses, SAP integration, and multi-level government workflow approvals.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

    <header class="cs-hero">
      <div class="cs-hero-meta">
        <span class="cs-badge cs-badge-corporate">Corporate</span><span class="cs-badge cs-badge-client">Sampoerna</span>
        <span class="cs-badge cs-badge-critical">Mission Critical</span>
        <span class="cs-badge cs-badge-year">April 2021</span>
      </div>
      <h1 class="cs-hero-title">
        EMS Enterprise Suite<br>
        <span>Excise Management System</span>
      </h1>
      <p class="cs-hero-desc">
        A government-regulated excise compliance platform built for PT Sampoerna — Indonesia's largest tobacco manufacturer. Manages the complete lifecycle of excisable goods: electronic excise document submission (CK-1 through CK-5, PBCK series, LACK series), excise payment and billing, brand registration, manufacturing licenses, SAP integration, and multi-level government workflow approvals.
      </p>
      <div class="cs-stack-pills">
        <span class="cs-stack-pill">C# .NET 4.5</span>
        <span class="cs-stack-pill">ASP.NET MVC 5</span>
        <span class="cs-stack-pill">Web API 2</span>
        <span class="cs-stack-pill">Entity Framework 6</span>
        <span class="cs-stack-pill">SQL Server</span>
        <span class="cs-stack-pill">SimpleInjector</span>
        <span class="cs-stack-pill">Crystal Reports</span>
        <span class="cs-stack-pill">Quartz.NET</span>
        <span class="cs-stack-pill">iTextSharp</span>
        <span class="cs-stack-pill">Kendo UI</span>
        <span class="cs-stack-pill">TinyMCE</span>
        <span class="cs-stack-pill">SSIS</span>
      </div>
    </header>

    <section class="cs-section">
      <div class="cs-section-label">
        <span class="cs-section-label-num">01</span>
        <span class="cs-section-label-text">Impact &amp; Metrics</span>
