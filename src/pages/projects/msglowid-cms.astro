---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="MS Glow Enterprise CMS - Mas Muhammad" description="An enterprise content management system with genuine product verification for MS Glow cosmetics brand. Features multi-tenant CMS for product catalog, brand storytelling, SEO content, clinic directory, and QR-based product authentication. Built on .NET 5 with microservices architecture serving both public storefront (Nuxt.js) and admin panel (ASP.NET MVC + Vue).">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
    <div class="cs-hero-meta">
      <span class="cs-badge badge-consulting">Consulting</span>
      <span class="cs-badge cs-badge-domain">E-commerce CMS</span>
      <span class="cs-badge cs-badge-year">January 2022</span>
    </div>
    <h1 class="cs-hero-title">
      Enterprise CMS<br>
      <span>&amp; Genuine Verification</span><span class="cs-cursor"></span>
    </h1>
    <p class="cs-hero-desc">
      An enterprise content management system with genuine product verification for MS
      Glow cosmetics brand. Features multi-tenant CMS for product catalog, brand
      storytelling, SEO content, clinic directory, and QR-based product authentication.
      Built on .NET 5 with microservices architecture serving both public storefront
      (Nuxt.js) and admin panel (ASP.NET MVC + Vue).
    </p>
    <div class="cs-stack-pills">
      <span class="cs-stack-pill">C# .NET 5</span>
      <span class="cs-stack-pill">Vue.js / Nuxt.js</span>
      <span class="cs-stack-pill">MongoDB</span>
      <span class="cs-stack-pill">JWT Auth</span>
      <span class="cs-stack-pill">AutoMapper</span>
      <span class="cs-stack-pill">Swagger</span>
      <span class="cs-stack-pill">Docker + K8s</span>
      <span class="cs-stack-pill">GitLab CI</span>
    </div>
  </header>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">01</span>
      <span class="cs-section-label-text">Impact &amp; Metrics</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-metrics-grid">
      <div class="cs-metric-card">
        <div class="cs-metric-val">100K+</div>
        <div class="cs-metric-label">Lines of Code</div>
        <div class="cs-metric-sub">C# + Vue + JS + Razor</div>
      </div>
      <div class="cs-metric-card">
        <div class="cs-metric-val">129+</div>
        <div class="cs-metric-label">API Endpoints</div>
        <div class="cs-metric-sub">RESTful microservices</div>
      </div>
      <div class="cs-metric-card">
        <div class="cs-metric-val">39</div>
        <div class="cs-metric-label">Database Collections</div>
        <div class="cs-metric-sub">MongoDB</div>
      </div>
      <div class="cs-metric-card cs-red">
        <div class="cs-metric-val">10</div>
        <div class="cs-metric-label">Complexity Score</div>
        <div class="cs-metric-sub">Mission Critical</div>
      </div>
    </div>

    <div class="cs-business-line-cards">
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Content Management</div>
        <div class="cs-bl-card-desc">Full enterprise CMS for news, journal, banner, brand story, PR, FAQs, static pages, legal, sub-brands, YouTube integration with image upload and rich content editing.</div>
        <span class="cs-bl-card-tag">Enterprise CMS</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Genuine Verification</div>
        <div class="cs-bl-card-desc">QR code-based product authentication system with passphrase generation, hash tracking, batch file upload, CDN storage, and public verify checker API for consumers.</div>
        <a href="https://cek.msgl.io" target="_blank" rel="noopener noreferrer" class="cs-bl-card-demo">Live Demo — <span>cek.msgl.io</span></a>
        <span class="cs-bl-card-tag cs-amber-tag">Anti-Counterfeit</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Product Ecosystem</div>
        <div class="cs-bl-card-desc">Product catalog with SKU management, sub-product taxonomy by classification/category/skin concern, variant management, gallery, and ingredients tracking.</div>
        <span class="cs-bl-card-tag">Product Catalog</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Admin &amp; Directory</div>
        <div class="cs-bl-card-desc">Administrator panel for all content, seller/member management, clinic directory, area database (provinces to villages), and wiki sync from external sources.</div>
        <span class="cs-bl-card-tag cs-amber-tag">Admin Panel</span>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">02</span>
      <span class="cs-section-label-text">Architecture</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-arch-diagram">
      <div class="cs-arch-diagram-inner">
        <div class="cs-arch-node cs-source">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Public Storefront</div>
          <div class="cs-arch-node-sub">Nuxt.js</div>
        </div>
        <div class="cs-arch-node cs-source">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Admin Panel</div>
          <div class="cs-arch-node-sub">ASP.NET MVC</div>
        </div>
        <div class="cs-arch-node cs-source">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Genuine Checker</div>
          <div class="cs-arch-node-sub">Vue SPA</div>
        </div>
        <div class="cs-arch-arrow" style="min-width: 30px;">
          <div class="cs-arch-arrow-line" style="width: 15px;"></div>
        </div>
        <div style="display:flex; flex-direction:column; align-items:center; gap:0;">
          <div class="cs-arch-node core" style="width:210px;">
            <div class="cs-arch-node-label" style="font-size:13px; margin-bottom:10px;">API Gateway &amp; Services</div>
            <div class="cs-core-stack">
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Main API (28+ Controllers)</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Products API</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Genuine Checker API</div>
              <div class="cs-core-step"><div class="cs-core-step-dot" style="background:var(--blue)"></div>CDN / Media Service</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Application Layer</div>
            </div>
          </div>
        </div>
        <div class="cs-arch-arrow">
          <div class="cs-arch-arrow-line"></div>
          <div class="cs-arch-arrow-label">persist</div>
        </div>
        <div class="cs-arch-node cs-output">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">MongoDB</div>
          <div class="cs-arch-node-sub">39 collections</div>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">03</span>
      <span class="cs-section-label-text">Tech Stack</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr><td class="cs-layer">Runtime</td><td class="cs-tech">.NET 5.0 / .NET Core 3.1</td></tr>
          <tr><td class="cs-layer">Web Framework</td><td class="cs-tech">ASP.NET Core Web API + MVC</td></tr>
          <tr><td class="cs-layer">Frontend</td><td class="cs-tech">Nuxt.js / Vue CLI / Vue 2 / Vuetify 2</td></tr>
          <tr><td class="cs-layer">Database</td><td class="cs-tech">MongoDB (MongoDB.Driver)</td></tr>
          <tr><td class="cs-layer">Auth</td><td class="cs-tech">JWT Bearer + Basic Authentication</td></tr>
          <tr><td class="cs-layer">API Documentation</td><td class="cs-tech">Swagger / Swashbuckle</td></tr>
          <tr><td class="cs-layer">ORM</td><td class="cs-tech">Custom MongoDBContext + Expression-to-SQL parser</td></tr>
          <tr><td class="cs-layer">Excel/CSV</td><td class="cs-tech">EPPlus, CsvHelper, ExcelDataReader</td></tr>
          <tr><td class="cs-layer">Email</td><td class="cs-tech">MailKit + MimeKit</td></tr>
          <tr><td class="cs-layer">Mapping</td><td class="cs-tech">AutoMapper</td></tr>
          <tr><td class="cs-layer">Background Jobs</td><td class="cs-tech">.NET Worker Service</td></tr>
          <tr><td class="cs-layer">Infrastructure</td><td class="cs-tech">Docker + Kubernetes (GKE) + GitLab CI</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">04</span>
      <span class="cs-section-label-text">Capabilities</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr><td class="cs-layer">CMS Modules</td><td class="cs-tech">Banner, Brand Story, News, Journal, Public Relations, FAQs, Static Pages, Legal, Sub-Brands, YouTube</td></tr>
          <tr><td class="cs-layer">Product Management</td><td class="cs-tech">SKU catalog, sub-product taxonomy, classification, category, skin concern, gallery, variants, ingredients</td></tr>
          <tr><td class="cs-layer">Genuine Verification</td><td class="cs-tech">QR authentication, passphrase system, hash collection, batch upload, CDN delivery, public checker API</td></tr>
          <tr><td class="cs-layer">Seller &amp; Member</td><td class="cs-tech">Registration, city-based search, activation workflow, session management, role-based access</td></tr>
          <tr><td class="cs-layer">Clinic Directory</td><td class="cs-tech">Aesthetic clinic listings, city-based directory, contact management</td></tr>
          <tr><td class="cs-layer">Geographic Data</td><td class="cs-tech">Populated provinces, regencies, districts, villages database with search API</td></tr>
          <tr><td class="cs-layer">Wiki Sync</td><td class="cs-tech">External wiki synchronization for sellers, products, and dimension data</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  </div>

  <Footer />
</Layout>
