            <td class="cs-row-label">Compliance reporting</td>
            <td class="cs-before">Manual report compilation</td>
            <td class="cs-after">SSRS on-demand reports</td>
            <td class="cs-delta">Regulatory-ready in minutes</td>
          </tr>
          <tr>
