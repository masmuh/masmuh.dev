<Layout title="e-Promat: Enterprise Material Logistics - Mas Muhammad" description="An enterprise promotional material logistics system for Sanofi managing the full lifecycle of promotional items from procurement to distribution, inventory management, and destruction. Built with VB.NET ASP.NET WebForms with multi-level approval workflows.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
    <div class="cs-hero-meta">
      <span class="cs-badge cs-badge-corporate">Corporate</span><span class="cs-badge cs-badge-client">Sanofi</span> 
      
      <span class="cs-badge cs-badge-domain">Pharma / Material Logistics</span>
      <span class="cs-badge cs-badge-year">October 2014</span>
    </div>
    <h1 class="cs-hero-title">e-Promat <span>Enterprise Material Logistics</span><span class="cs-cursor"></span></h1>
    <p class="cs-hero-desc">
      An enterprise promotional material logistics system for Sanofi managing the full lifecycle of promotional items from procurement to distribution, inventory management, and destruction. Built with VB.NET ASP.NET WebForms with multi-level approval workflows.
    </p>
    <div class="cs-stack-pills">
      <span class="cs-stack-pill">VB.NET</span>
      <span class="cs-stack-pill">ASP.NET WebForms</span>
      <span class="cs-stack-pill">.NET 2.0</span>
      <span class="cs-stack-pill">SQL Server</span>
      <span class="cs-stack-pill">AjaxControlToolkit</span>
      <span class="cs-stack-pill">SSRS Reports</span>
      <span class="cs-stack-pill">30+ Tables</span>
    </div>
  </header>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-text">Impact</span>
      <div class="cs-section-label-line"></div>
      <span class="cs-section-label-num">01</span>
    </div>
    <div class="cs-metrics-grid">
      <div class="cs-metric-card">
        <div class="cs-metric-val">8,300+</div>
        <div class="cs-metric-label">Lines of Code</div>
        <div class="cs-metric-sub">VB.NET code-behind</div>
      </div>
      <div class="cs-metric-card cs-amber">
        <div class="cs-metric-val">0</div>
        <div class="cs-metric-label">API Endpoints</div>
        <div class="cs-metric-sub">Traditional WebForms</div>
      </div>
      <div class="cs-metric-card cs-amber">
        <div class="cs-metric-val">30+</div>
        <div class="cs-metric-label">Database Tables</div>
        <div class="cs-metric-sub">SQL Server relational</div>
      </div>
      <div class="cs-metric-card cs-red">
        <div class="cs-metric-val">10</div>
        <div class="cs-metric-label">Complexity Score</div>
        <div class="cs-metric-sub">Mission Critical</div>
      </div>
    </div>
  </section>

