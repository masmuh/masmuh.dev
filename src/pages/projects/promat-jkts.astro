          </tr>
          <tr>
            <td class="cs-layer">UI Toolkit</td>
            <td class="cs-tech">AjaxControlToolkit · Server Controls</td>
          </tr>
          <tr>
            <td class="cs-layer">Reporting</td>
            <td class="cs-tech">SQL Server Reporting Services (SSRS)</td>
          </tr>
          <tr>
            <td class="cs-layer">Notifications</td>
            <td class="cs-tech">SMTP Email (System.Net.Mail)</td>
          </tr>
          <tr>
            <td class="cs-layer">Architecture</td>
            <td class="cs-tech">ASPX → Code-Behind → SP → SQL Server</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  </div>

  <Footer />
</Layout>
