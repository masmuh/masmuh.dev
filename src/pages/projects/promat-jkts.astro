          <div class="cs-arch-arrow-line"></div>
          <div class="cs-arch-arrow-label">postback</div>
        </div>

        <div style="display:flex; flex-direction:column; align-items:center; gap:0;">
          <div class="cs-arch-node core" style="width:220px;">
            <div class="cs-arch-node-label" style="font-size:13px; margin-bottom:10px;">Code-Behind Layer</div>
            <div class="cs-core-stack">
              <div class="cs-core-step">
                <div class="cs-core-step-dot"></div>
                Event handlers · Page_Load
              </div>
              <div class="cs-core-step">
                <div class="cs-core-step-dot"></div>
                Approval workflow logic
              </div>
              <div class="cs-core-step">
                <div class="cs-core-step-dot" style="background:var(--blue)"></div>
                ADO.NET · Stored Procedures
              </div>
            </div>
          </div>
          <div class="cs-schema-connector" style="margin-top:0;">
            <div class="cs-schema-line-v"></div>
            <div class="cs-schema-arrow-label">30+ tables</div>
            <div class="cs-schema-line-v"></div>
            <div class="cs-arch-node cs-schema-node">
              <div class="cs-arch-node-label" style="font-size:11px; color: #f59e0b;">SQL Server</div>
              <div class="cs-arch-node-sub">Stored Procedures</div>
            </div>
          </div>
        </div>

        <div style="display:flex; flex-direction:column; align-items:center;">
          <div class="cs-arch-arrow">
            <div class="cs-arch-arrow-line"></div>
            <div class="cs-arch-arrow-label">email</div>
          </div>
          <div class="cs-arch-node cs-output" style="margin-top:4px;">
            <div class="cs-arch-node-icon"></div>
            <div class="cs-arch-node-label">SMTP Notification</div>
            <div class="cs-arch-node-sub">Approval workflow</div>
          </div>
