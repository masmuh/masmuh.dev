---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="MS Glow Seller Shop - Mas Muhammad" description="A multi-service seller management platform for MS Glow cosmetics brand, enabling multi-channel order management, payment processing through Xendit and Midtrans, integrated shipping with Shipper, inventory tracking, and a comprehensive order lifecycle from checkout to delivery. Built with C# (.NET 6) and Go microservices following clean architecture with background workers.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
    <div class="cs-hero-meta">
      <span class="cs-badge badge-consulting">Consulting</span>
      <span class="cs-badge cs-badge-domain">E-commerce</span>
      <span class="cs-badge cs-badge-year">January 2022</span>
    </div>
    <h1 class="cs-hero-title">
      MS Glow<br>
      <span>Seller Shop</span><span class="cs-cursor"></span>
    </h1>
    <p class="cs-hero-desc">
      A multi-service seller management platform for MS Glow cosmetics brand, enabling
      multi-channel order management, payment processing through Xendit and Midtrans,
      integrated shipping with Shipper, inventory tracking, and a comprehensive order
      lifecycle from checkout to delivery. Built with C# (.NET 6) and Go microservices
      following clean architecture with background workers.
    </p>
    <div class="cs-stack-pills">
      <span class="cs-stack-pill">C# .NET 6</span>
      <span class="cs-stack-pill">Go 1.17</span>
      <span class="cs-stack-pill">MongoDB</span>
      <span class="cs-stack-pill">Xendit</span>
      <span class="cs-stack-pill">Midtrans</span>
      <span class="cs-stack-pill">Shipper</span>
      <span class="cs-stack-pill">JWT Auth</span>
      <span class="cs-stack-pill">Docker + K8s</span>
    </div>
  </header>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">01</span>
      <span class="cs-section-label-text">Impact &amp; Metrics</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-metrics-grid">
      <div class="cs-metric-card">
        <div class="cs-metric-val">78K+</div>
        <div class="cs-metric-label">Lines of Code</div>
        <div class="cs-metric-sub">Go + C# + JS + Razor</div>
      </div>
      <div class="cs-metric-card">
        <div class="cs-metric-val">120+</div>
        <div class="cs-metric-label">API Endpoints</div>
        <div class="cs-metric-sub">RESTful microservices</div>
      </div>
      <div class="cs-metric-card">
        <div class="cs-metric-val">53+</div>
        <div class="cs-metric-label">Database Models</div>
        <div class="cs-metric-sub">MongoDB + SQL</div>
      </div>
      <div class="cs-metric-card cs-red">
        <div class="cs-metric-val">10</div>
        <div class="cs-metric-label">Complexity Score</div>
        <div class="cs-metric-sub">Mission Critical</div>
      </div>
    </div>

    <div class="cs-business-line-cards">
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">E-commerce</div>
        <div class="cs-bl-card-desc">Multi-channel seller platform for product management, shopping cart order lifecycle, inventory tracking, and pricing with tiering rules across seller networks.</div>
        <span class="cs-bl-card-tag">Order Management</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Payments</div>
        <div class="cs-bl-card-desc">Integrated Xendit and Midtrans payment gateways supporting virtual accounts, invoicing, disbursements, balance management, fee rules, and callback processing.</div>
        <span class="cs-bl-card-tag cs-amber-tag">Xendit + Midtrans</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Shipping</div>
        <div class="cs-bl-card-desc">Multi-carrier shipping integration via Shipper API v1/v3 for rate lookup, order creation, pickup scheduling, tracking, and AWB monitoring with background workers.</div>
        <span class="cs-bl-card-tag cs-amber-tag">Shipper API</span>
      </div>
      <div class="cs-bl-card">
        <div class="cs-bl-card-title">Communications</div>
        <div class="cs-bl-card-desc">In-app chat messaging, WhatsApp/OTP via Twilio, email via MailKit, and push notifications for order status updates and seller alerts.</div>
        <span class="cs-bl-card-tag">Twilio + MailKit</span>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">02</span>
      <span class="cs-section-label-text">Architecture</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-arch-diagram">
      <div class="cs-arch-diagram-inner">
        <div class="cs-arch-node cs-source">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">UI Backpanel</div>
          <div class="cs-arch-node-sub">ASP.NET MVC + JS</div>
        </div>
        <div class="cs-arch-arrow">
          <div class="cs-arch-arrow-line"></div>
          <div class="cs-arch-arrow-label">HTTPS</div>
        </div>
        <div style="display:flex; flex-direction:column; align-items:center; gap:0;">
          <div class="cs-arch-node core" style="width:220px;">
            <div class="cs-arch-node-label" style="font-size:13px; margin-bottom:10px;">API Gateway</div>
            <div class="cs-core-stack">
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>C# Web API (30+ Controllers)</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Go Payment Service</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Go Shipping Service</div>
              <div class="cs-core-step"><div class="cs-core-step-dot" style="background:var(--blue)"></div>Go App Service</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Scheduler Workers</div>
            </div>
          </div>
        </div>
        <div class="cs-arch-arrow">
          <div class="cs-arch-arrow-line"></div>
          <div class="cs-arch-arrow-label">persist</div>
        </div>
        <div class="cs-arch-node cs-output">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">MongoDB</div>
          <div class="cs-arch-node-sub">Primary database</div>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">03</span>
      <span class="cs-section-label-text">Tech Stack</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr><td class="cs-layer">Runtime (C#)</td><td class="cs-tech">.NET 6.0</td></tr>
          <tr><td class="cs-layer">Runtime (Go)</td><td class="cs-tech">Go 1.17</td></tr>
          <tr><td class="cs-layer">Web Framework (C#)</td><td class="cs-tech">ASP.NET Core + AutoMapper + Swagger</td></tr>
          <tr><td class="cs-layer">Web Framework (Go)</td><td class="cs-tech">Go-Chi</td></tr>
          <tr><td class="cs-layer">Database</td><td class="cs-tech">MongoDB + MySQL + PostgreSQL</td></tr>
          <tr><td class="cs-layer">Payment Gateway</td><td class="cs-tech">Xendit + Midtrans</td></tr>
          <tr><td class="cs-layer">Shipping</td><td class="cs-tech">Shipper API v1/v3</td></tr>
          <tr><td class="cs-layer">Messaging</td><td class="cs-tech">Twilio + MailKit</td></tr>
          <tr><td class="cs-layer">Auth</td><td class="cs-tech">JWT Bearer + Basic Auth</td></tr>
          <tr><td class="cs-layer">Background Jobs</td><td class="cs-tech">NCrontab Workers (Invoice Settlement, AWB, Approval)</td></tr>
          <tr><td class="cs-layer">Monitoring</td><td class="cs-tech">Elastic APM + Logrus</td></tr>
          <tr><td class="cs-layer">Infrastructure</td><td class="cs-tech">Docker + Kubernetes (GKE) + ArgoCD</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">04</span>
      <span class="cs-section-label-text">Capabilities</span>
      <span class="cs-section-label-line"></span>
    </div>

    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr><td class="cs-layer">Order Lifecycle</td><td class="cs-tech">Checkout, approval, picking, shipment, delivery, receive, close, cancel, force-close</td></tr>
          <tr><td class="cs-layer">Payment Processing</td><td class="cs-tech">Virtual account, transfer, balance, invoice, fee rules, disbursement, callback</td></tr>
          <tr><td class="cs-layer">Shipping</td><td class="cs-tech">Rate lookup, order creation, pickup scheduling, tracking, AWB, multi-carrier</td></tr>
          <tr><td class="cs-layer">Seller Management</td><td class="cs-tech">Registration, activation, tiering, pricing, product sync, downline network</td></tr>
          <tr><td class="cs-layer">Product Management</td><td class="cs-tech">Catalog, inventory, pricing, margin, markup, stock sync, barcode scan</td></tr>
          <tr><td class="cs-layer">Finance</td><td class="cs-tech">Balance history, withdrawal, invoicing, receivable settings, reconciliation</td></tr>
          <tr><td class="cs-layer">Communications</td><td class="cs-tech">Chat messaging, WhatsApp OTP, email notifications, push notifications</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  </div>

  <Footer />
</Layout>
