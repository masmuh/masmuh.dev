---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="CXO Report - Mas Muhammad" description="Enterprise KPI orchestration service built with Go. ETL background service that aggregates transactional data from MongoDB into a staging/reporting database, computes Balanced Scorecard (BSC) KPIs for corporate and department dashboards, and serves chart-ready data via REST API.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
<div class="cs-hero-meta">
<span class="cs-badge cs-badge-corporate">Corporate</span><span class="cs-badge cs-badge-client">Kano Solution</span> 
<span class="cs-badge cs-badge-year">February 2026</span>
</div>
<h1 class="cs-hero-title">CXO <span>Report</span><span class="cs-cursor"></span></h1>
<p class="cs-hero-desc">
Enterprise KPI orchestration service built with Go. ETL background service that aggregates transactional data from MongoDB into a staging/reporting database, computes Balanced Scorecard (BSC) KPIs for corporate and department dashboards, and serves chart-ready data via REST API.
</p>
<div class="cs-stack-pills">
<span class="cs-stack-pill">Go 1.23</span>
<span class="cs-stack-pill">MongoDB</span>
<span class="cs-stack-pill">REST API</span>
<span class="cs-stack-pill">JWT Auth</span>
<span class="cs-stack-pill">Cron Scheduler</span>
<span class="cs-stack-pill">Balanced Scorecard</span>
</div>
</header>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Impact</span>
<div class="cs-section-label-line"></div>
<span class="cs-section-label-num">01</span>
</div>
<div class="cs-metrics-grid">
<div class="cs-metric-card">
<div class="cs-metric-val">5,260</div>
<div class="cs-metric-label">Lines of Code</div>
<div class="cs-metric-sub">Go across 39 source files</div>
</div>
<div class="cs-metric-card">
<div class="cs-metric-val">19</div>
<div class="cs-metric-label">API Endpoints</div>
<div class="cs-metric-sub">RESTful interfaces</div>
</div>
<div class="cs-metric-card">
<div class="cs-metric-val">10</div>
<div class="cs-metric-label">Complexity Score</div>
<div class="cs-metric-sub">Based on code analysis</div>
</div>
<div class="cs-metric-card">
<div class="cs-metric-val">Mission Critical</div>
<div class="cs-metric-label">System Level</div>
<div class="cs-metric-sub">Impact classification</div>
</div>
</div>
</section>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Architecture</span>
<div class="cs-section-label-line"></div>
<span class="cs-section-label-num">02</span>
</div>
<div class="cs-arch-diagram">
<div class="cs-arch-diagram-inner">

<div class="cs-arch-node cs-source">
<div class="cs-arch-node-icon"></div>
<div class="cs-arch-node-label">MongoDB</div>
<div class="cs-arch-node-sub">Source operational DB</div>
</div>

<div class="cs-arch-arrow">
<div class="cs-arch-arrow-line"></div>
<div class="cs-arch-arrow-label">ETL pipeline</div>
</div>

<div style="display:flex; flex-direction:column; align-items:center; gap:0;">
<div class="cs-arch-node core" style="width:220px;">
<div class="cs-arch-node-label" style="font-size:13px; margin-bottom:10px;">Go REST Service</div>
<div class="cs-core-stack">
<div class="cs-core-step"><div class="cs-core-step-dot"></div>HTTP Handler</div>
<div class="cs-core-step"><div class="cs-core-step-dot"></div>Transformer (ETL)</div>
<div class="cs-core-step"><div class="cs-core-step-dot" style="background:var(--blue)"></div>Repository Layer</div>
</div>
</div>
<div class="cs-schema-connector" style="margin-top:0;">
<div class="cs-schema-line-v"></div>
<div class="cs-arch-node cs-schema-node" style="margin-top:8px; border-color:rgba(245,158,11,0.3);">
<div class="cs-arch-node-label" style="font-size:11px; color: #f59e0b;"> Cron Scheduler</div>
<div class="cs-arch-node-sub">Interval / CRON / Manual</div>
</div>
</div>
</div>

<div class="cs-arch-arrow">
<div class="cs-arch-arrow-line"></div>
<div class="cs-arch-arrow-label">persist</div>
</div>

<div class="cs-arch-node cs-output">
<div class="cs-arch-node-icon"></div>
<div class="cs-arch-node-label">MongoDB</div>
<div class="cs-arch-node-sub">Staging / Reporting DB</div>
</div>

<div class="cs-arch-arrow" style="min-width:40px;">
<div class="cs-arch-arrow-line" style="width:30px;"></div>
<div class="cs-arch-arrow-label">serve</div>
</div>

<div class="cs-arch-node cs-source" style="border-color:rgba(96,165,250,0.3);">
<div class="cs-arch-node-icon"></div>
<div class="cs-arch-node-label">Dashboard API</div>
<div class="cs-arch-node-sub">BSC KPIs · Charts</div>
</div>

</div>
</div>
</section>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Tech Stack</span>
<div class="cs-section-label-line"></div>
<span class="cs-section-label-num">03</span>
</div>
<div class="cs-impact-wrapper">
<table class="cs-stack-table">
<tbody>
<tr><td class="cs-layer">Runtime</td><td class="cs-tech">Go 1.23.3 (single binary)</td></tr>
<tr><td class="cs-layer">Web Framework</td><td class="cs-tech">Kaos (internal Kanosolution HTTP framework)</td></tr>
<tr><td class="cs-layer">Database</td><td class="cs-tech">MongoDB (mongo-driver v1.17)</td></tr>
<tr><td class="cs-layer">Authentication</td><td class="cs-tech">JWT (golang-jwt/jwt v5, HS256)</td></tr>
<tr><td class="cs-layer">Scheduler</td><td class="cs-tech">robfig/cron v3 (6-field CRON + interval support)</td></tr>
<tr><td class="cs-layer">ORM</td><td class="cs-tech">dbflex (internal Kanosolution data framework)</td></tr>
<tr><td class="cs-layer">Deployment</td><td class="cs-tech">hd (HTTP deployer, internal Kanoteknologi)</td></tr>
<tr><td class="cs-layer">Configuration</td><td class="cs-tech">YAML (gopkg.in/yaml.v3)</td></tr>
</tbody>
</table>
</div>
</section>

<section class="cs-section">
<div class="cs-section-label">
<span class="cs-section-label-text">Capabilities</span>
<div class="cs-section-label-line"></div>
<div class="cs-section-label-num">04</div>
</div>
<div class="cs-impact-wrapper">
<table class="cs-stack-table">
<tbody>
<tr><td class="cs-layer">ETL Pipeline</td><td class="cs-tech">MongoDB aggregation pipeline builder that transforms transactional data (Ledger, Cash, Vendor, Customer, Payroll, Assets) into staging outputs</td></tr>
<tr><td class="cs-layer">Balanced Scorecard</td><td class="cs-tech">Corporate and department BSC computation with 4 perspectives: Finance, Customer, Internal Process, Growth</td></tr>
<tr><td class="cs-layer">Job Scheduling</td><td class="cs-tech">Background scheduler with interval, CRON, and manual trigger modes; configurable retention policies</td></tr>
<tr><td class="cs-layer">REST API</td><td class="cs-tech">19 JWT-protected endpoints for mapping management, settings, scorecards, and dashboard chart data</td></tr>
<tr><td class="cs-layer">Idempotent Processing</td><td class="cs-tech">Deterministic ID generation via MD5 hashing for safe upsert and batch tracking</td></tr>
<tr><td class="cs-layer">Dashboard Charts</td><td class="cs-tech">Bar/line chart data formatted for ECharts/Chart.js with results, gaps, and quarterly breakdowns</td></tr>
</tbody>
</table>
</div>
</section>

  </div>

  <Footer />
</Layout>
