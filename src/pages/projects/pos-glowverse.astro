---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="POS Glowverse - Mas Muhammad" description="A point-of-sale and seller commerce platform for MS Glow cosmetics brand enabling product and inventory management, complete shopping cart order lifecycle with multi-status workflow, payment processing via Xendit, shipment tracking with AWB integration, invoice management, chat messaging, and real-time dashboard analytics. Built with C# (.NET 6) and Go microservices with clean architecture.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
    <div class="cs-hero-meta">
      <span class="cs-badge badge-consulting">Consulting</span>
      <span class="cs-badge cs-badge-domain">E-commerce / POS</span>
      <span class="cs-badge cs-badge-year">February 2024</span>
    </div>
    <h1 class="cs-hero-title">
      POS<br>
      <span>Glowverse</span><span class="cs-cursor"></span>
    </h1>
    <p class="cs-hero-desc">
      A point-of-sale and seller commerce platform for MS Glow cosmetics brand enabling
      product and inventory management, complete shopping cart order lifecycle with
      multi-status workflow, payment processing via Xendit, shipment tracking with AWB
      integration, invoice management, chat messaging, and real-time dashboard analytics.
      Built with C# (.NET 6) and Go microservices with clean architecture.
    </p>
    <div class="cs-stack-pills">
      <span class="cs-stack-pill">C# .NET 6</span>
      <span class="cs-stack-pill">Go 1.17</span>
      <span class="cs-stack-pill">MongoDB</span>
      <span class="cs-stack-pill">Xendit</span>
      <span class="cs-stack-pill">Twilio</span>
      <span class="cs-stack-pill">JWT Auth</span>
      <span class="cs-stack-pill">Docker + K8s</span>
    </div>
  </header>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">01</span>
      <span class="cs-section-label-text">Impact &amp; Metrics</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-metrics-grid">
      <div class="cs-metric-card"><div class="cs-metric-val">60K+</div><div class="cs-metric-label">Lines of Code</div><div class="cs-metric-sub">C# + Go + Razor</div></div>
      <div class="cs-metric-card"><div class="cs-metric-val">108+</div><div class="cs-metric-label">API Endpoints</div><div class="cs-metric-sub">RESTful + Go services</div></div>
      <div class="cs-metric-card"><div class="cs-metric-val">50+</div><div class="cs-metric-label">Database Models</div><div class="cs-metric-sub">MongoDB collections</div></div>
      <div class="cs-metric-card cs-red"><div class="cs-metric-val">10</div><div class="cs-metric-label">Complexity Score</div><div class="cs-metric-sub">Mission Critical</div></div>
    </div>
    <div class="cs-business-line-cards">
      <div class="cs-bl-card"><div class="cs-bl-card-title">Order Management</div><div class="cs-bl-card-desc">Complete order lifecycle with checkout, approval, picking, shipment, delivery, receive, close, cancel, force-close, and manual received workflows.</div><span class="cs-bl-card-tag">Order Lifecycle</span></div>
      <div class="cs-bl-card"><div class="cs-bl-card-title">Payments &amp; Finance</div><div class="cs-bl-card-desc">Xendit payment gateway integration for transactions, balance management, withdrawal history, invoice processing, account receivable, and callbacks.</div><span class="cs-bl-card-tag cs-amber-tag">Xendit Gateway</span></div>
      <div class="cs-bl-card"><div class="cs-bl-card-title">Seller Commerce</div><div class="cs-bl-card-desc">Seller registration, product management with margin/markup rules, inventory sync, outlet management, discount/promo engine, and dashboard analytics.</div><span class="cs-bl-card-tag">Seller Tools</span></div>
      <div class="cs-bl-card"><div class="cs-bl-card-title">Communications</div><div class="cs-bl-card-desc">In-app chat, WhatsApp/SMS via Twilio, email via MailKit, push notifications, and background workers for settlement, AWB updates, and approval expiry.</div><span class="cs-bl-card-tag cs-amber-tag">Twilio + MailKit</span></div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">02</span>
      <span class="cs-section-label-text">Architecture</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-arch-diagram">
      <div class="cs-arch-diagram-inner">
        <div class="cs-arch-node cs-source"><div class="cs-arch-node-icon"></div><div class="cs-arch-node-label">API Client</div><div class="cs-arch-node-sub">Mobile / Web</div></div>
        <div class="cs-arch-arrow"><div class="cs-arch-arrow-line"></div><div class="cs-arch-arrow-label">HTTPS</div></div>
        <div style="display:flex; flex-direction:column; align-items:center; gap:0;">
          <div class="cs-arch-node core" style="width:220px;">
            <div class="cs-arch-node-label" style="font-size:13px; margin-bottom:10px;">Backend Services</div>
            <div class="cs-core-stack">
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>C# Web API (26+ Controllers)</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Go App Service (Auth)</div>
              <div class="cs-core-step"><div class="cs-core-step-dot"></div>Application Layer (40+ Services)</div>
              <div class="cs-core-step"><div class="cs-core-step-dot" style="background:var(--blue)"></div>Scheduler Workers (4)</div>
            </div>
          </div>
        </div>
        <div class="cs-arch-arrow"><div class="cs-arch-arrow-line"></div><div class="cs-arch-arrow-label">persist</div></div>
        <div class="cs-arch-node cs-output"><div class="cs-arch-node-icon"></div><div class="cs-arch-node-label">MongoDB</div><div class="cs-arch-node-sub">Primary database</div></div>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">03</span>
      <span class="cs-section-label-text">Tech Stack</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr><td class="cs-layer">Runtime (C#)</td><td class="cs-tech">.NET 6.0</td></tr>
          <tr><td class="cs-layer">Runtime (Go)</td><td class="cs-tech">Go 1.17</td></tr>
          <tr><td class="cs-layer">Web Framework (C#)</td><td class="cs-tech">ASP.NET Core + AutoMapper + Swagger</td></tr>
          <tr><td class="cs-layer">Web Framework (Go)</td><td class="cs-tech">Go-Chi with JWT middleware</td></tr>
          <tr><td class="cs-layer">Database</td><td class="cs-tech">MongoDB (primary) + PostgreSQL + MySQL</td></tr>
          <tr><td class="cs-layer">Payment Gateway</td><td class="cs-tech">Xendit (invoice, VA, transfer, disbursement)</td></tr>
          <tr><td class="cs-layer">Messaging</td><td class="cs-tech">Twilio (WhatsApp/SMS) + MailKit (Email)</td></tr>
          <tr><td class="cs-layer">Auth</td><td class="cs-tech">JWT Bearer + Basic Auth + Bcrypt</td></tr>
          <tr><td class="cs-layer">Background Jobs</td><td class="cs-tech">NCrontab Workers (Settlement, AWB, Approval, Sync)</td></tr>
          <tr><td class="cs-layer">Monitoring</td><td class="cs-tech">Elastic APM + Logrus</td></tr>
          <tr><td class="cs-layer">Infrastructure</td><td class="cs-tech">Docker + Kubernetes (GKE) + GitLab CI</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">04</span>
      <span class="cs-section-label-text">Capabilities</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr><td class="cs-layer">Order Workflow</td><td class="cs-tech">Checkout, approve, process, ready-to-pick, ship, receive, close, cancel, force-close, manual-receive</td></tr>
          <tr><td class="cs-layer">Product Management</td><td class="cs-tech">Catalog, inventory, pricing, margin/markup, stock sync, barcode scan, discount promo engine</td></tr>
          <tr><td class="cs-layer">Payment Processing</td><td class="cs-tech">Transaction, balance, withdrawal, invoice, callback, OTP confirmation, account receivable</td></tr>
          <tr><td class="cs-layer">Shipment</td><td class="cs-tech">Shipping rate, area management, tracking, AWB, pickup scheduling, callback tracking</td></tr>
          <tr><td class="cs-layer">Dashboard</td><td class="cs-tech">Best-selling products, low-stock alerts, transaction lists, seller performance metrics</td></tr>
          <tr><td class="cs-layer">Auth &amp; Security</td><td class="cs-tech">JWT tokens, Basic Auth, bcrypt passwords, session management, role-based access, rate limiting</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  </div>

  <Footer />
</Layout>
