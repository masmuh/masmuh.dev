---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Transformation Portal - Mas Muhammad" description="A CRM transformation employee engagement portal for Telkomsel featuring interactive quiz/survey systems with leader communications and news management. Built with ASP.NET WebForms on .NET Framework 2.0 with LDAP authentication.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
    <div class="cs-hero-meta">
      <span class="cs-badge cs-badge-corporate">Corporate</span><span class="cs-badge cs-badge-client">Telkomsel</span> 
      
      <span class="cs-badge cs-badge-year">March 2014</span>
    </div>
    <h1 class="cs-hero-title">Transformation <span>Portal</span><span class="cs-cursor"></span></h1>
    <p class="cs-hero-desc">
      A CRM transformation employee engagement portal for Telkomsel featuring interactive quiz/survey systems with leader communications and news management. Built with ASP.NET WebForms on .NET Framework 2.0 with LDAP authentication.
    </p>
    <div class="cs-stack-pills">
      <span class="cs-stack-pill">ASP.NET WebForms 2.0</span>
      <span class="cs-stack-pill">C#</span>
      <span class="cs-stack-pill">.NET 2.0</span>
      <span class="cs-stack-pill">SQL Server</span>
      <span class="cs-stack-pill">LDAP / AD</span>
      <span class="cs-stack-pill">jQuery</span>
      <span class="cs-stack-pill">CKEditor</span>
      <span class="cs-stack-pill">CKFinder</span>
    </div>
  </header>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-text">Impact</span>
      <div class="cs-section-label-line"></div>
      <span class="cs-section-label-num">01</span>
    </div>
    <div class="cs-metrics-grid">
      <div class="cs-metric-card">
        <div class="cs-metric-val">23,000+</div>
        <div class="cs-metric-label">Lines of Code</div>
        <div class="cs-metric-sub">C# ASP.NET WebForms</div>
      </div>
      <div class="cs-metric-card cs-amber">
        <div class="cs-metric-val">0</div>
        <div class="cs-metric-label">API Endpoints</div>
        <div class="cs-metric-sub">Traditional WebForms (no API)</div>
      </div>
      <div class="cs-metric-card cs-red">
        <div class="cs-metric-val">10</div>
        <div class="cs-metric-label">Complexity Score</div>
        <div class="cs-metric-sub">Mission Critical</div>
      </div>
      <div class="cs-metric-card cs-amber">
        <div class="cs-metric-val">Mission Critical</div>
        <div class="cs-metric-label">System Level</div>
        <div class="cs-metric-sub">Enterprise employee platform</div>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-text">Architecture</span>
      <div class="cs-section-label-line"></div>
      <span class="cs-section-label-num">02</span>
    </div>
    <div class="cs-arch-diagram">
      <div class="cs-arch-diagram-inner">

        <div class="cs-arch-node cs-source">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">ASPX Pages</div>
          <div class="cs-arch-node-sub">UI / Presentation</div>
        </div>

        <div class="cs-arch-arrow">
          <div class="cs-arch-arrow-line"></div>
          <div class="cs-arch-arrow-label">postback</div>
        </div>

        <div style="display:flex; flex-direction:column; align-items:center; gap:0;">
          <div class="cs-arch-node core" style="width:220px;">
            <div class="cs-arch-node-label" style="font-size:13px; margin-bottom:10px;">Code-Behind Layer</div>
            <div class="cs-core-stack">
              <div class="cs-core-step">
                <div class="cs-core-step-dot"></div>
                Event handlers · Page_Load
              </div>
              <div class="cs-core-step">
                <div class="cs-core-step-dot"></div>
                Business logic · validation
              </div>
              <div class="cs-core-step">
                <div class="cs-core-step-dot" style="background:var(--blue)"></div>
                ADO.NET · SqlConnection
              </div>
            </div>
          </div>
          <div class="cs-schema-connector" style="margin-top:0;">
            <div class="cs-schema-line-v"></div>
            <div class="cs-schema-arrow-label">18 tables</div>
            <div class="cs-schema-line-v"></div>
            <div class="cs-arch-node cs-schema-node">
              <div class="cs-arch-node-label" style="font-size:11px; color: #f59e0b;">SQL Server</div>
              <div class="cs-arch-node-sub">CRUD operations</div>
            </div>
          </div>
        </div>

        <div class="cs-arch-arrow">
          <div class="cs-arch-arrow-line"></div>
          <div class="cs-arch-arrow-label">LDAP bind</div>
        </div>

        <div class="cs-arch-node cs-output">
          <div class="cs-arch-node-icon"></div>
          <div class="cs-arch-node-label">Active Directory</div>
          <div class="cs-arch-node-sub">telkomsel.co.id</div>
        </div>

      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-text">Decision Log</span>
      <div class="cs-section-label-line"></div>
      <span class="cs-section-label-num">03</span>
    </div>
    <div class="cs-decision-list">

      <div class="cs-decision-card">
        <div class="cs-decision-header">
          <div class="cs-decision-num">01</div>
          <div>
            <div class="cs-decision-title">Authentication Strategy — LDAP / Active Directory Integration</div>
            <div class="cs-decision-problem">
              Need to authenticate thousands of Telkomsel employees without building a custom auth system.
            </div>
          </div>
        </div>
        <div class="cs-decision-body">
          <div>
            <div class="cs-decision-col-label cs-chosen">▸ Chosen</div>
            <div class="cs-decision-col-text">
              LDAP/Active Directory integration against the telkomsel.co.id domain. Employees authenticate with their existing corporate credentials — zero registration, zero password management.
            </div>
          </div>
          <div>
            <div class="cs-decision-col-label cs-tradeoff">▸ Trade-off</div>
            <div class="cs-decision-col-text">
              Cookie-based auth without modern OAuth — acceptable for an internal corporate portal behind the company firewall. No SSO federation, but operationally simple.
            </div>
          </div>
        </div>
        <div class="cs-decision-code">
<pre><span class="cs-token-cm">// LDAP authentication against telkomsel.co.id</span>
<span class="cs-token-kw">using</span> (DirectoryEntry entry = <span class="cs-token-kw">new</span> <span class="cs-token-fn">DirectoryEntry</span>(
    <span class="cs-token-str">"LDAP://telkomsel.co.id"</span>, username, password))
&#123;
    DirectorySearcher searcher = <span class="cs-token-kw">new</span> <span class="cs-token-fn">DirectorySearcher</span>(entry);
    searcher.Filter = <span class="cs-token-str">$"(sAMAccountName=&#123;username&#125;)"</span>;
    SearchResult result = searcher.<span class="cs-token-fn">FindOne</span>();
    <span class="cs-token-kw">return</span> result != <span class="cs-token-kw">null</span>;
&#125;</pre>
        </div>
      </div>

      <div class="cs-decision-card">
        <div class="cs-decision-header">
          <div class="cs-decision-num">02</div>
          <div>
            <div class="cs-decision-title">CRUD Architecture — Uniform Content Management Pattern</div>
            <div class="cs-decision-problem">
              Managing multiple content types (highlights, messages, banners, quizzes) with consistent patterns across the portal.
            </div>
          </div>
        </div>
        <div class="cs-decision-body">
          <div>
            <div class="cs-decision-col-label cs-chosen">▸ Chosen</div>
            <div class="cs-decision-col-text">
              Uniform CRUD pattern (content/form/proses/view) applied across all entity types. Each content type follows the same file structure: list page, form page, process handler, and detail view.
            </div>
          </div>
          <div>
            <div class="cs-decision-col-label cs-tradeoff">▸ Trade-off</div>
            <div class="cs-decision-col-text">
              Code duplication vs. consistency — consistency won for maintainability by the operations team. Standardized pattern means any developer can understand any module instantly.
            </div>
          </div>
        </div>
        <div class="cs-decision-code">
<pre><span class="cs-token-cm">// Uniform CRUD pattern — every content type follows this</span>
<span class="cs-token-cm">// /admin/highlights/     → list, form, proses, view</span>
<span class="cs-token-cm">// /admin/messages/       → list, form, proses, view</span>
<span class="cs-token-cm">// /admin/banners/        → list, form, proses, view</span>
<span class="cs-token-cm">// /admin/quizzes/        → list, form, proses, view</span>

<span class="cs-token-kw">protected void</span> <span class="cs-token-fn">Page_Load</span>(<span class="cs-token-kw">object</span> sender, EventArgs e)
&#123;
    <span class="cs-token-kw">if</span> (!IsPostBack) <span class="cs-token-fn">BindGrid</span>();
&#125;

<span class="cs-token-kw">protected void</span> <span class="cs-token-fn">BtnSave_Click</span>(<span class="cs-token-kw">object</span> sender, EventArgs e)
&#123;
    <span class="cs-token-fn">ExecuteNonQuery</span>(<span class="cs-token-str">"INSERT INTO ..."</span>);
    <span class="cs-token-fn">BindGrid</span>();
&#125;</pre>
        </div>
      </div>

      <div class="cs-decision-card">
        <div class="cs-decision-header">
          <div class="cs-decision-num">03</div>
          <div>
            <div class="cs-decision-title">Rich Content — WYSIWYG with CKEditor + CKFinder</div>
            <div class="cs-decision-problem">
              Content editors need to author rich news articles and leadership messages with embedded images, media, and formatted text without HTML knowledge.
            </div>
          </div>
        </div>
        <div class="cs-decision-body">
          <div>
            <div class="cs-decision-col-label cs-chosen">▸ Chosen</div>
            <div class="cs-decision-col-text">
              CKEditor for WYSIWYG editing with CKFinder integration for image/file browsing and upload. Familiar interface for non-technical content editors across multiple departments.
            </div>
          </div>
          <div>
            <div class="cs-decision-col-label cs-tradeoff">▸ Trade-off</div>
            <div class="cs-decision-col-text">
              Third-party dependency adds licensing considerations and version lock-in. CKFinder requires server-side file management — implemented custom ASP.NET handler for uploads.
            </div>
          </div>
        </div>
        <div class="cs-decision-code">
<pre><span class="cs-token-cm">// CKEditor initialization on admin forms</span>
&lt;textarea id=<span class="cs-token-str">"contentBody"</span> runat=<span class="cs-token-str">"server"</span>&gt;&lt;/textarea&gt;

<span class="cs-token-fn">CKEditorReplace</span>(<span class="cs-token-str">"contentBody"</span>, <span class="cs-token-kw">new</span> CKEditorSettings
&#123;
    ToolbarSet = <span class="cs-token-str">"Full"</span>,
    FilebrowserImageBrowseUrl = <span class="cs-token-str">"/ckfinder/ckfinder.html"</span>,
    Height = <span class="cs-token-acc">400</span>
&#125;);</pre>
        </div>
      </div>

    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-text">Business Impact</span>
      <div class="cs-section-label-line"></div>
      <span class="cs-section-label-num">04</span>
    </div>
    <div class="cs-impact-wrapper">
      <table class="cs-impact-table">
        <thead>
          <tr>
            <th>Metric</th>
            <th>Before</th>
            <th>After</th>
            <th>Delta</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="cs-row-label">Employee engagement</td>
            <td class="cs-before">Email / manual comms</td>
            <td class="cs-after">Centralized portal</td>
            <td class="cs-delta">Enterprise-wide reach</td>
          </tr>
          <tr>
            <td class="cs-row-label">Content publishing</td>
            <td class="cs-before">Email newsletters</td>
            <td class="cs-after">CMS workflow</td>
            <td class="cs-delta">Multi-dept publishing</td>
          </tr>
          <tr>
            <td class="cs-row-label">Quiz / survey adoption</td>
            <td class="cs-before">Paper / spreadsheets</td>
            <td class="cs-after">Online interactive</td>
            <td class="cs-delta">Real-time leaderboard</td>
          </tr>
          <tr>
            <td class="cs-row-label">File management</td>
            <td class="cs-before">Shared drives</td>
            <td class="cs-after">Structured CMS</td>
            <td class="cs-delta">3,000+ files managed</td>
          </tr>
          <tr>
            <td class="cs-row-label">Authentication</td>
            <td class="cs-before">Individual credentials</td>
            <td class="cs-after">LDAP SSO</td>
            <td class="cs-delta">Zero-friction access</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-text">Tech Stack</span>
      <div class="cs-section-label-line"></div>
      <span class="cs-section-label-num">05</span>
    </div>
    <div class="cs-impact-wrapper">
      <table class="cs-stack-table">
        <tbody>
          <tr>
            <td class="cs-layer">Framework</td>
            <td class="cs-tech">ASP.NET WebForms 2.0 · .NET Framework 2.0</td>
          </tr>
          <tr>
            <td class="cs-layer">Language</td>
            <td class="cs-tech">C#</td>
          </tr>
          <tr>
            <td class="cs-layer">Database</td>
            <td class="cs-tech">SQL Server (18 tables)</td>
          </tr>
          <tr>
            <td class="cs-layer">Data Access</td>
            <td class="cs-tech">ADO.NET · SqlConnection · SqlCommand</td>
          </tr>
          <tr>
            <td class="cs-layer">Authentication</td>
            <td class="cs-tech">LDAP / Active Directory (telkomsel.co.id)</td>
          </tr>
          <tr>
            <td class="cs-layer">Rich Text</td>
            <td class="cs-tech">CKEditor · CKFinder</td>
          </tr>
          <tr>
            <td class="cs-layer">Frontend</td>
            <td class="cs-tech">jQuery · ASP.NET WebForms</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  </div>

  <Footer />
</Layout>
