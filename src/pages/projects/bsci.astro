<Layout title="DRMS — SAP Middleware - Mas Muhammad" description="An enterprise SAP Business ByDesign integration middleware comprising two components: a REST API gateway that exposes SAP ERP functions (sales orders, credit notes, returns, stock transfers) as JSON endpoints for external applications, and a background scheduler that periodically extracts SAP master/transactional data to CSV files for a third-party B2B analytics gateway.">
  <Nav variant="subpage" backHref="/portfolio" backText="Back to Portfolio" />

  <div class="cs-page">

<header class="cs-hero">
    <div class="cs-hero-meta">
      <span class="cs-badge cs-badge-corporate">Corporate</span><span class="cs-badge cs-badge-client">Boston Scientific</span> 
      <span class="cs-badge cs-badge-year">June 2021</span>
    </div>
    <h1 class="cs-hero-title">DRMS<br><span>Distributor Relationship &amp; SAP Integration Platform</span></h1>
    <p class="cs-hero-desc">An enterprise SAP Business ByDesign integration middleware comprising two components: a REST API gateway that exposes SAP ERP functions (sales orders, credit notes, returns, stock transfers) as JSON endpoints for external applications, and a background scheduler that periodically extracts SAP master/transactional data to CSV files for a third-party B2B analytics gateway.</p>
    <div class="cs-stack-pills">
      <span class="cs-stack-pill">.NET 5</span><span class="cs-stack-pill">ASP.NET Core</span><span class="cs-stack-pill">Web API</span><span class="cs-stack-pill">SOAP/WCF</span><span class="cs-stack-pill">OData</span><span class="cs-stack-pill">Redis</span><span class="cs-stack-pill">CsvHelper</span><span class="cs-stack-pill">Swagger</span><span class="cs-stack-pill">MailKit</span><span class="cs-stack-pill">Worker Service</span>
    </div>
  </header>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">01</span>
      <span class="cs-section-label-text">Impact &amp; Metrics</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-metrics-grid">
      <div class="cs-metric-card cs-amber"><div class="cs-metric-val">62K</div><div class="cs-metric-label">Lines of Code</div><div class="cs-metric-sub">C# — 167 source files</div></div>
      <div class="cs-metric-card cs-amber"><div class="cs-metric-val">6</div><div class="cs-metric-label">REST API Endpoints</div><div class="cs-metric-sub">Sales Order, Credit Note, Returns</div></div>
      <div class="cs-metric-card cs-blue"><div class="cs-metric-val">6</div><div class="cs-metric-label">Background Workers</div><div class="cs-metric-sub">CSV export to B2B gateway</div></div>
      <div class="cs-metric-card cs-amber"><div class="cs-metric-val">6</div><div class="cs-metric-label">Complexity Rating</div><div class="cs-metric-sub">Enterprise Application</div></div>
    </div>
    <div class="cs-impact-wrapper" style="margin-top:20px">
      <table class="cs-impact-table">
        <thead><tr><th>Area</th><th>Before</th><th>After</th><th></th></tr></thead>
        <tbody>
          <tr><td class="cs-row-label">SAP Integration</td><td class="cs-before">Direct SOAP calls, no abstraction</td><td class="cs-after">Clean REST API with Swagger docs + auth</td><td class="cs-delta">+ standardized</td></tr>
          <tr><td class="cs-row-label">Data Distribution</td><td class="cs-before">Manual CSV exports</td><td class="cs-after">6 automated workers with Redis cache</td><td class="cs-delta">+ fully automated</td></tr>
          <tr><td class="cs-row-label">Error Handling</td><td class="cs-before">Unhandled SOAP faults</td><td class="cs-after">Structured ResultApi + email notification</td><td class="cs-delta">+ observable</td></tr>
          <tr><td class="cs-row-label">Deployment</td><td class="cs-before">Manual IIS deploys</td><td class="cs-after">Windows Service + certificate auth</td><td class="cs-delta">+ secure</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">02</span>
      <span class="cs-section-label-text">Architecture</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-arch-diagram">
      <div class="cs-arch-diagram-inner">
        <div class="cs-arch-node"><div class="cs-arch-node-icon"></div><div class="cs-arch-node-label">External Apps</div><div class="cs-arch-node-sub">REST JSON clients</div></div>
        <div class="cs-arch-arrow"><div class="cs-arch-arrow-line"></div><div class="cs-arch-arrow-label">REST API</div></div>
        <div class="cs-arch-node core">
          <div class="cs-arch-node-icon"></div><div class="cs-arch-node-label">DRMS API Gateway</div><div class="cs-arch-node-sub">ASP.NET Core 5 - Swagger</div>
          <div class="cs-core-stack">
            <div class="cs-core-step"><span class="cs-core-step-dot"></span>Controllers — JSON in/out</div>
            <div class="cs-core-step"><span class="cs-core-step-dot cs-blue"></span>Services — Business Logic</div>
            <div class="cs-core-step"><span class="cs-core-step-dot"></span>SOAP/OData — SAP ByDesign</div>
          </div>
        </div>
        <div class="cs-arch-arrow"><div class="cs-arch-arrow-line"></div><div class="cs-arch-arrow-label">SOAP</div></div>
        <div class="cs-arch-node"><div class="cs-arch-node-icon"></div><div class="cs-arch-node-label">SAP ByDesign</div><div class="cs-arch-node-sub">Cloud ERP</div></div>
      </div>
    </div>
    <div style="margin-top:20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;justify-content:center">
      <div class="cs-arch-node cs-db-node"><div class="cs-arch-node-icon"></div><div class="cs-arch-node-label">Scheduler</div><div class="cs-arch-node-sub">Worker Service - Cronos</div></div>
      <div class="cs-arch-arrow" style="min-width:40px"><div class="cs-arch-arrow-line" style="width:20px"></div><div class="cs-arch-arrow-label">CSV</div></div>
      <div class="cs-arch-node cs-db-node"><div class="cs-arch-node-icon"></div><div class="cs-arch-node-label">B2B Gateway</div><div class="cs-arch-node-sub">b2bgw.bsci.com</div></div>
      <div class="cs-arch-arrow" style="min-width:40px"><div class="cs-arch-arrow-line" style="width:20px"></div><div class="cs-arch-arrow-label">cache</div></div>
      <div class="cs-arch-node cs-db-node"><div class="cs-arch-node-icon"></div><div class="cs-arch-node-label">Redis</div><div class="cs-arch-node-sub">Cache tracking</div></div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">03</span>
      <span class="cs-section-label-text">Key Capabilities</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-cap-list">
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Sales Order creation in SAP ByDesign via REST JSON</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Credit Note processing with/without stock impact</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Return Order (Inbound Delivery Notification)</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Stock Transfer Order (Customer Demand)</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Customer Invoice CSV export to B2B gateway</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Customer &amp; Material master CSV sync</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Account Receivables (all/open/prev-month) CSV</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Pricelist data extraction to CSV</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Posted Inbound Logistics CSV reporting</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Redis cache for incremental data tracking</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Email notifications on job success/failure</div>
      <div class="cs-cap-item"><span class="cs-cap-icon"></span>Certificate + Basic Auth security</div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">04</span>
      <span class="cs-section-label-text">Decision Log</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-decision-list">
      <div class="cs-decision-card">
        <div class="cs-decision-header">
          <span class="cs-decision-num">01</span>
          <div>
            <div class="cs-decision-title">Clean Architecture Over Traditional N-Tier</div>
            <div class="cs-decision-problem">The DRMS needed to be both a REST API gateway and a background scheduler sharing the same business logic. Traditional N-tier would have caused code duplication or tight coupling between the two runtimes.</div>
          </div>
        </div>
        <div class="cs-decision-body">
          <div>
            <div class="cs-decision-col-label cs-chosen">Chosen — Clean Architecture</div>
            <div class="cs-decision-col-text">drms.domain held pure DTOs with zero dependencies. drms.application housed all business logic (21 service modules) and SOAP/OData connectivity. Both drms-api and scheduler depended on drms.application — sharing 100% of business logic across two entry points.</div>
          </div>
          <div>
            <div class="cs-decision-col-label cs-tradeoff">Tradeoff — Monolithic API + Scheduler</div>
            <div class="cs-decision-col-text">Combining them would have simplified deployment but created availability coupling. Clean architecture overhead was minimal compared to operational independence gained.</div>
          </div>
        </div>
        <div class="cs-decision-code">
<pre><span class="cs-token-cm">// Shared service consumed by both API and Scheduler</span>
<span class="cs-token-kw">public class</span> <span class="cs-token-fn">SalesOrderService</span> : ISalesOrderService
&#123;
    <span class="cs-token-kw">public async</span> Task&lt;ResultApi&gt; <span class="cs-token-fn">Insert</span>(string url, string user, string pass, SalesOrderParam param)
    &#123;
        <span class="cs-token-kw">var</span> client = <span class="cs-token-kw">new</span> <span class="cs-token-fn">ServiceSalesOrderClient</span>(...);
        <span class="cs-token-kw">return await</span> client.<span class="cs-token-fn">ManageSalesOrderInAsync</span>(<span class="cs-token-fn">MapFromParam</span>(param));
    &#125;
&#125;</pre>
        </div>
      </div>

      <div class="cs-decision-card">
        <div class="cs-decision-header">
          <span class="cs-decision-num">02</span>
          <div>
            <div class="cs-decision-title">SOAP + OData Dual Strategy for SAP ByD</div>
            <div class="cs-decision-problem">SAP ByDesign exposes SOAP (WCF) for transactional writes and OData REST for queries. SOAP is rich but slow; OData is fast but limited for writes. Choosing one would limit functionality.</div>
          </div>
        </div>
        <div class="cs-decision-body">
          <div>
            <div class="cs-decision-col-label cs-chosen">Chosen — SOAP for writes, OData for reads</div>
            <div class="cs-decision-col-text">Sales Order creation and Credit Note posting used SOAP via WCF Connected Services. Bulk data population (products, customers, invoices) used OData with pagination for performance. Redis cache tracked OData state.</div>
          </div>
          <div>
            <div class="cs-decision-col-label cs-tradeoff">Tradeoff — Single protocol</div>
            <div class="cs-decision-col-text">Pure SOAP would be too slow for 3000+ records hourly. Pure OData lacked transactional depth. Dual approach optimized for each use case.</div>
          </div>
        </div>
        <div class="cs-decision-code">
<pre><span class="cs-token-cm">// OData paginated read (fast)</span>
<span class="cs-token-kw">var</span> response = <span class="cs-token-kw">await</span> _httpClient.<span class="cs-token-fn">GetAsync</span>(
    <span class="cs-token-str">$"&#123;url&#125;/sap/byd/odata/.../ProductCollection?$top=3000&$skip=&#123;skip&#125;"</span>);

<span class="cs-token-cm">// SOAP transactional write (reliable)</span>
<span class="cs-token-kw">var</span> client = <span class="cs-token-kw">new</span> <span class="cs-token-fn">ServiceSalesOrderClient</span>(...);
<span class="cs-token-kw">var</span> result = <span class="cs-token-kw">await</span> client.<span class="cs-token-fn">ManageSalesOrderInAsync</span>(request);</pre>
        </div>
      </div>

      <div class="cs-decision-card">
        <div class="cs-decision-header">
          <span class="cs-decision-num">03</span>
          <div>
            <div class="cs-decision-title">Redis Cache for Scheduler State Tracking</div>
            <div class="cs-decision-problem">Six background workers ran on intervals to extract SAP data to CSV. Without state tracking, every run would duplicate records and waste API quota. File-based tracking would fail on restarts.</div>
          </div>
        </div>
        <div class="cs-decision-body">
          <div>
            <div class="cs-decision-col-label cs-chosen">Chosen — Redis Cache</div>
            <div class="cs-decision-col-text">Each worker stored its last run timestamp and processed IDs in Redis. Workers checked Redis before fetching to only retrieve new records. Cache expiration ensured eventual re-sync.</div>
          </div>
          <div>
            <div class="cs-decision-col-label cs-tradeoff">Tradeoff — SQL Server / File-based</div>
            <div class="cs-decision-col-text">SQL Server added latency. Files lost data on permission changes. Redis provided sub-ms access, built-in expiration, and survived restarts.</div>
          </div>
        </div>
        <div class="cs-decision-code">
<pre><span class="cs-token-cm">// Redis cache check before OData fetch</span>
<span class="cs-token-kw">var</span> cached = <span class="cs-token-kw">await</span> _cache.<span class="cs-token-fn">GetAsync</span>(cacheKey);
<span class="cs-token-kw">if</span> (cached != <span class="cs-token-kw">null</span>) <span class="cs-token-kw">return</span> cached;

<span class="cs-token-kw">var</span> data = <span class="cs-token-kw">await</span> <span class="cs-token-fn">FetchFromOData</span>(url, user, pass);
<span class="cs-token-kw">await</span> _cache.<span class="cs-token-fn">SetAsync</span>(cacheKey, data, TimeSpan.FromHours(1));</pre>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-section">
    <div class="cs-section-label">
      <span class="cs-section-label-num">05</span>
      <span class="cs-section-label-text">Tech Stack</span>
      <span class="cs-section-label-line"></span>
    </div>
    <div class="cs-arch-diagram">
      <table class="cs-stack-table">
        <tr><td class="cs-layer">Runtime</td><td class="cs-tech">.NET 5.0, ASP.NET Core, Kestrel</td></tr>
        <tr><td class="cs-layer">API Layer</td><td class="cs-tech">ASP.NET Core Web API, Swashbuckle 5.6, Basic + Certificate Auth</td></tr>
        <tr><td class="cs-layer">SAP Integration</td><td class="cs-tech">SOAP via WCF Connected Services, OData REST, CSRF token handling</td></tr>
        <tr><td class="cs-layer">Scheduler</td><td class="cs-tech">.NET Worker Service, Cronos 0.7, IHostedService, Windows Service</td></tr>
        <tr><td class="cs-layer">Data Export</td><td class="cs-tech">CsvHelper 27.1, CSV generation, SFTP upload to B2B gateway</td></tr>
        <tr><td class="cs-layer">Caching</td><td class="cs-tech">StackExchange.Redis 6.0, Redis localhost</td></tr>
        <tr><td class="cs-layer">Messaging</td><td class="cs-tech">MailKit 2.15, MimeKit 2.15, SMTP Office 365</td></tr>
        <tr><td class="cs-layer">Serialization</td><td class="cs-tech">Newtonsoft.Json 13.0, System.Text.Json</td></tr>
        <tr><td class="cs-layer">Architecture</td><td class="cs-tech">Clean Architecture: domain / application / api / scheduler</td></tr>
      </table>
    </div>
  </section>

  </div>

  <Footer />
</Layout>
