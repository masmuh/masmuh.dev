---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});
---

<Layout
  title="Portfolio — Mas Muhammad"
  description="Selected projects spanning enterprise architectures, distributed systems, and AI tooling — 28 systems built for Biogen, Sanofi, Shell, Sampoerna and more."
>
  <Nav variant="subpage" backText="Back to Home" activePath="/portfolio" />

  <main class="container-page pt-14 pb-4 md:pt-20">
    <div class="border-b-2 border-ink/10 pb-8">
      <div class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-accent-deep">
        // Selected Work
      </div>
      <h1 class="mt-2 text-[clamp(2.4rem,6vw,4.5rem)] font-extrabold leading-none tracking-tight">
        Portfolio<span class="text-accent-deep">.</span>
      </h1>
      <p class="mt-4 max-w-lg text-[0.95rem] leading-relaxed text-ink-soft">
        A collection of corporate, consulting, open-source, and personal projects —
        spanning enterprise architectures, autonomous AI pipelines, and high-performance
        backend systems.
      </p>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-bold text-ink-soft">
      <span class="text-ink"><span class="text-accent-deep">{projects.length}</span> systems</span>
      <span class="text-ink/20">·</span>
      <span><span class="text-accent-deep">13</span> years</span>
      <span class="text-ink/20">·</span>
      <span>Fortune 500 clients</span>
      <span class="text-ink/20">·</span>
      <span>Zero critical downtime</span>
    </div>

    <div class="filter-bar mt-8 flex flex-wrap gap-2.5" role="tablist" aria-label="Filter projects">
      <button class="chip active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all shadow-brutal-sm border-2 !border-ink bg-accent text-white" data-filter="all">All</button>
      <button class="chip active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all shadow-brutal-sm border-2 !border-ink" data-filter="corporate">Corporate</button>
      <button class="chip active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all shadow-brutal-sm border-2 !border-ink" data-filter="consulting">Consulting</button>
      <button class="chip active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all shadow-brutal-sm border-2 !border-ink" data-filter="open-source">Open Source</button>
      <button class="chip active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all shadow-brutal-sm border-2 !border-ink" data-filter="personal">Personal</button>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {
        projects.map((project) => (
          <a
            href={`/projects/${project.id}`}
            class="card reveal group flex flex-col overflow-hidden rounded-2xl border-2 border-ink bg-paper shadow-brutal-sm transition-all duration-150 hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-brutal-sm"
            data-cat={project.data.category}
          >
            <div class={`relative flex aspect-video items-center justify-center overflow-hidden ${project.data.thumbClass || "thumb-shell"}`}>
              {project.data.image ? (
                <img
                  src={project.data.image}
                  alt={project.data.title}
                  class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="text-5xl opacity-70">{project.data.icon}</div>
              )}
              <span class="absolute bottom-3 right-3 rounded-lg border-2 border-ink bg-paper/90 px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-wide shadow-brutal-sm">
                {project.data.category}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <div class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.15em] text-accent-deep">
                {project.data.type}
              </div>
              <div class="mt-1.5 text-lg font-extrabold tracking-tight">{project.data.title}</div>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">
                {project.data.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {project.data.stack.slice(0, 5).map((tag) => (
                  <span class="stack-tag">{tag}</span>
                ))}
              </div>
              <div class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-accent-deep">
                View Details
                <i class="bi bi-arrow-right transition-transform duration-200 group-hover:translate-x-1"></i>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </main>

  <Footer />

  <script>
    function filter(cat, btn) {
      document
        .querySelectorAll(".filter-bar .chip")
        .forEach((b) => b.classList.remove("!bg-accent", "!text-white"));
      btn.classList.add("!bg-accent", "!text-white");
      document.querySelectorAll(".card").forEach((card) => {
        const match = cat === "all" || card.dataset.cat === cat;
        card.classList.toggle("hidden", !match);
        card.setAttribute("aria-hidden", String(!match));
      });
    }

    document.querySelectorAll(".filter-bar .chip").forEach((btn) => {
      btn.addEventListener("click", () => filter(btn.dataset.filter, btn));
    });
  </script>
</Layout>

<style>
  .filter-bar .chip { cursor: pointer; }
  .card.hidden { display: none; }

  .thumb-oats { background: linear-gradient(135deg, #d4b8f0, #c4a8e0); }
  .thumb-wicara { background: linear-gradient(135deg, #b0d0e8, #98c0d8); }
  .thumb-jobhunter { background: linear-gradient(135deg, #b0e0c0, #98d0b0); }
  .thumb-foculing { background: linear-gradient(135deg, #e0c0a8, #d0b098); }
  .thumb-msglow { background: linear-gradient(135deg, #b0d0d0, #98c0c0); }
  .thumb-portaglow { background: linear-gradient(135deg, #f5d8a0, #e8c890); }
  .thumb-posglowverse { background: linear-gradient(135deg, #a8e0c0, #90d0b0); }
  .thumb-academic { background: linear-gradient(135deg, #c0d8a0, #b0c890); }
  .thumb-sampoerna { background: linear-gradient(135deg, #e0b0b0, #d0a0a0); }
  .thumb-shell { background: linear-gradient(135deg, #e0c890, #d0b888); }
  .thumb-telkomsel { background: linear-gradient(135deg, #e0b0c0, #d0a0b0); }
</style>