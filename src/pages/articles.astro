---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Articles — Mas Muhammad" description="Latest articles and technical writing by Mas Muhammad, published on DEV.to">
  <Nav variant="default" activePath="/articles" statusText="DEV.TO" />

  <main class="container-page pt-12 pb-4 md:pt-16">
    <div class="border-b-2 border-ink/10 pb-8">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-accent-deep">
            [ Articles + Writing ]
          </div>
          <h1 class="mt-2 text-[clamp(2rem,5vw,3.5rem)] font-extrabold leading-none tracking-tight">
            Latest <span class="text-ink-mute">Article</span><span class="text-accent-deep">.</span>
          </h1>
          <p class="mt-4 max-w-lg text-[0.95rem] leading-relaxed text-ink-soft">
            My latest technical writing on software engineering, distributed systems, and backend
            architecture — automatically fetched from DEV.to.
          </p>
        </div>
        <div class="flex flex-col items-start gap-2 md:items-end">
          <div class="font-mono text-xs uppercase tracking-wide text-ink-mute" id="last-updated">
            Loading latest article...
          </div>
          <a
            href="https://dev.to/insight105"
            target="_blank"
            rel="noopener noreferrer"
            class="chip chip-accent !py-1.5 text-xs"
          >
            <i class="bi bi-box-arrow-up-right"></i>
            DEV.TO
          </a>
        </div>
      </div>
    </div>

    <div class="article-card card-brutal mt-8 overflow-hidden bg-paper" id="article-card">
      <div class="article-loading flex flex-col items-center justify-center gap-4 py-20" id="article-loading">
        <div class="loading-spinner h-9 w-9 animate-spin rounded-full border-[3px] border-ink/15 border-t-accent"></div>
        <span class="font-mono text-xs uppercase tracking-widest text-ink-mute">Fetching latest article...</span>
      </div>
    </div>

    <div class="article-error mt-8 hidden flex-col items-center gap-3 rounded-2xl border-2 border-ink bg-paper p-10 text-center shadow-brutal-sm" id="article-error">
      <div class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-ink bg-red-50 text-lg font-extrabold text-red-600 shadow-brutal-sm">
        !
      </div>
      <p class="text-sm text-ink-soft">
        Unable to fetch the latest article. Check back later or visit
        <a href="https://dev.to/insight105" target="_blank" rel="noopener noreferrer" class="font-bold text-accent-deep underline underline-offset-2">
          dev.to/insight105 →
        </a>
      </p>
    </div>
  </main>

  <Footer />

  <script>
    async function loadLatestArticle() {
      const container = document.getElementById("article-card");
      const loading = document.getElementById("article-loading");
      const error = document.getElementById("article-error");
      const updated = document.getElementById("last-updated");

      async function fetchFrom(url) {
        const res = await fetch(url);
        if (!res.ok) throw new Error("API error");
        return await res.json();
      }

      function proxyImage(url) {
        if (!url) return "/og-image.png";
        return "/.netlify/functions/devto-image-proxy?url=" + encodeURIComponent(url);
      }

      function escapeHtml(s) {
        const d = document.createElement("div");
        d.textContent = s;
        return d.innerHTML;
      }

      async function renderArticle(article) {
        loading.style.display = "none";
        error.style.display = "none";
        updated.textContent =
          "DEV.to • " +
          new Date(article.publishedAt).toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          });

        const tagsHtml = (article.tags || [])
          .map((t) => `<span class="stack-tag">#${escapeHtml(t)}</span>`)
          .join("");

        container.innerHTML = `
          <div class="article-cover aspect-video w-full overflow-hidden border-b-2 border-ink/10 bg-cloud">
            <img src="${proxyImage(article.coverImage)}" alt="${escapeHtml(article.title)}" loading="lazy" class="h-full w-full object-cover" />
          </div>
          <div class="p-5 md:p-8">
            <div class="flex flex-wrap items-center gap-3">
              <span class="chip chip-mint !py-1 text-xs">${article.readingTime} min read</span>
              <span class="font-mono text-xs uppercase tracking-wide text-ink-mute">${new Date(article.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
            </div>
            <h2 class="mt-4 text-2xl font-extrabold leading-tight tracking-tight md:text-3xl">${escapeHtml(article.title)}</h2>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-soft">${escapeHtml(article.description)}</p>
            <div class="mt-5 flex flex-wrap gap-2">${tagsHtml}</div>
            <a href="${escapeHtml(article.url)}" target="_blank" rel="noopener noreferrer" class="btn-brutal btn-accent mt-7">
              Read full article on DEV.to
              <i class="bi bi-box-arrow-up-right"></i>
            </a>
          </div>
        `;
      }

      try {
        const json = await fetchFrom("/.netlify/functions/devto-posts?per_page=1");
        if (json.success && json.data && json.data.length) {
          return renderArticle(json.data[0]);
        }
        throw new Error("No articles from Netlify function");
      } catch {
        try {
          const posts = await fetchFrom(
            "https://dev.to/api/articles?username=insight105&per_page=1"
          );
          if (posts && posts.length) {
            const p = posts[0];
            return renderArticle({
              title: p.title,
              description: p.description || p.social_media_text || "",
              url: p.url,
              publishedAt: p.published_at,
              tags: p.tag_list || [],
              readingTime: p.reading_time_minutes || 0,
              coverImage: p.cover_image || null,
            });
          }
          throw new Error("No articles from dev.to");
        } catch {
          loading.style.display = "none";
          error.classList.remove("hidden");
          error.classList.add("flex");
          updated.textContent = "Unable to load article";
        }
      }
    }

    document.addEventListener("DOMContentLoaded", loadLatestArticle);
  </script>
</Layout>